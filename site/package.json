{
  "name": "lerena-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4323",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run check:directline && npm run atlas && npm run publish:index && npm run same:data && npm run lines:data && npm run family:data && npm run flags:data && astro build && npm run autolink && npm run build:records && npm run linkrecords && npm run sitemap && npm run check:book && npm run check:story && npm run check:familyribbon && npm run check:ribbonflags && npm run check:lines && npm run check:living && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:evidence && npm run check:corrections && npm run check:tree && npm run check:spines && npm run check:sources && npm run check:named && npm run check:superseded && npm run check:onsite && npm run check:duplicates && npm run check:places && npm run check:living-standard && npm run check:living-years && npm run check:pages && npm run check:inline && npm run check:rows && npm run check:arity && npm run check:nav && npm run check:families && npm run check:names && npm run build:given && npm run check:standard && npm run check:era-ground && npm run check:era && npm run check:era-expect && npm run check:era:selftest",
    "same:data": "python3 ../tools/run-autolink.py --same-data",
    "lines:data": "python3 ../tools/build-lines.py",
    "family:data": "python3 ../tools/build-family-lines.py",
    "flags:data": "python3 ../tools/build-ribbon-flags.py",
    "check:directline": "python3 node_modules/@daviddef/archive-kit/kit/tools/directline.py --story src/data/story.json --check src/data/direct-line.json",
    "check:familyribbon": "python3 ../tools/build-family-lines.py --check && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --families src/data/family-lines.json --direct src/data/direct-line.json --story src/data/story.json --dist \"${ARCHIVE_OUT:-dist}\" --lines src/data/lerena-lines.json --living \"${AUTOLINK_LIVING:-${XDG_STATE_HOME:-$HOME/.local/state}/lerena/autolink-living.json}\" --strict && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --selftest",
    "check:ribbonflags": "python3 ../tools/build-ribbon-flags.py --gate \"${ARCHIVE_OUT:-dist}\" && python3 node_modules/@daviddef/archive-kit/kit/tools/checkribbonflags.py --selftest",
    "check:flagfit": "sh ../tools/check-flagfit.sh",
    "pick:same": "python3 ../tools/run-autolink.py --pick-same",
    "autolink": "python3 ../tools/run-autolink.py",
    "check:names": "python3 ../tools/run-autolink.py --gate",
    "build:records": "python3 ../tools/build-records.py",
    "linkrecords": "python3 ../tools/link-records.py",
    "build:given": "python3 ../tools/build-given-names.py",
    "check:standard": "python3 ../tools/run-autolink.py --standard",
    "check:era-ground": "python3 ../tools/build-era.py --check",
    "check:era": "python3 ../tools/build-era.py --living-urls && python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist dist --snapshot src/data/era-snapshot.json --living-urls \"$(python3 ../tools/build-era.py --living-path)\" --require-tracked",
    "check:era-expect": "python3 ../tools/check-era-expect.py --dist dist",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py",
    "floor:standard": "python3 ../tools/run-autolink.py --write-standard-floor",
    "selftest:standard": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard_selftest.py",
    "preview": "astro preview --port 4323",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "publish:index": "node -e \"require('fs').copyFileSync('src/data/searchindex.json','public/searchindex.json')\"",
    "check:lines": "python3 ../tools/build-lines.py --living-slugs && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --lines src/data/lerena-lines.json --dist dist --config standard.json --living \"$(python3 ../tools/build-lines.py --living-path)\" && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --selftest",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:story": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --story src/data/story.json --dist dist --person-base /people/ --living \"${AUTOLINK_LIVING:-${XDG_STATE_HOME:-$HOME/.local/state}/lerena/autolink-living.json}\" --strict && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --selftest",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare --years --config standard.json --strict-allow",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:evidence": "python3 ../tools/check-evidence.py",
    "check:corrections": "python3 ../tools/check-corrections.py",
    "check:onsite": "python3 ../tools/check-onsite.py",
    "check:duplicates": "python3 ../tools/check-duplicates.py",
    "check:places": "python3 ../tools/check-living-places.py",
    "check:living-standard": "python3 ../tools/check-living-standard.py",
    "check:living-years": "python3 ../tools/check-living-years.py",
    "check:living-gates": "python3 ../tools/test-living-gates.py",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 1",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 7",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:sources": "python3 ../tools/check-sources.py",
    "check:spines": "python3 ../tools/check-spines.py",
    "check:tree": "python3 ../tools/check-tree.py",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/people.json --born born --died died --max 0",
    "check:named": "python3 ../tools/check-people-named.py",
    "check:superseded": "python3 ../tools/check-superseded.py",
    "check:arity": "python3 ../tools/check-arity.py",
    "check:families": "python3 ../tools/check-families.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#1fa6b54e9168e271c6fff24bf5b8f32b73f92e20",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
