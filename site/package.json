{
  "name": "lerena-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4323",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run atlas && npm run publish:index && astro build && npm run sitemap && npm run check:living && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:evidence && npm run check:corrections && npm run check:onsite",
    "preview": "astro preview --port 4323",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "publish:index": "node -e \"require('fs').copyFileSync('src/data/searchindex.json','public/searchindex.json')\"",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:evidence": "python3 ../tools/check-evidence.py",
    "check:corrections": "python3 ../tools/check-corrections.py",
    "check:onsite": "python3 ../tools/check-onsite.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#99ba0dac3fc67fd62a4539010c8e75f28ca7c496",
    "astro": "^5.18.2"
  }
}
