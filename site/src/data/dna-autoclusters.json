 "the_control_that_makes_this_readable": {
  "kit": "her son",
  "what_it_shows": "His father is a Defranceski, of Istria and Croatia. His chart contains TWO plainly Croatian clusters - Butorac, Pavelich, Jagustin, Krkljes, Racic, Glas - sitting beside the Cape ones.",
  "why_it_matters": "AutoClusters demonstrably forms a distinct block for a foreign paternal line WHEN COUSINS FROM THAT LINE HAVE TESTED. The method is not blind to a non-Cape father. It found his."
 },
 "the_finding": {
  "her_clusters": 14,
  "her_matches_clustered": 107,
  "her_cM_floor": 50.6,
  "statement": "EVERY ONE OF HER FOURTEEN CLUSTERS IS CAPE AFRIKANER OR BRITISH ISLES. Attwell, Botha, Buitendag, Calitz, du Pisanie, du Plessis, Engelbrecht, Erasmus, Dippenaar, Lotter, de Kock, Bezuidenhout, Potgieter, de Lange, de Villiers, Volschenk, Niemann, Strauss, Viviers, Hamman, Nel, Theron, van der Westhuizen, van Zyl, Booyens, Jooste, Kroon, Joubert, Dreyer, Krugel, Sander, Jansen van Vuuren, Beukes, du Toit, Gouws, Marais, Bailey, Walker, Johnson, White, Butler, Daniel, Daschner.",
  "not_one": "Not one Spanish, Italian, Argentine or Uruguayan surname appears in any cluster on her chart.",
  "the_shape_of_it": "She has four grandparents. Fourteen clusters are accounted for by three of them. The fourth - Pablo Armando - has no cluster at all."
 },
 "the_nephew": {
  "who": "the only other Lerena who has tested",
  "clusters": 19,
  "surprise": "His chart is almost entirely ASHKENAZI JEWISH - Abrams, Litwack, Rothbart, Epstein, Goldman, Rosenzweig, Levitan, Novik, Aizenman, Graivier, Lumelsky, Mandel, Cohen, Goldberg, Weisberg, Waldman, Goldstein, Fishbein - with tree names in Hebrew and Russian. That is his MOTHER's family, not the Lerena line, and an endogamous population throws up far more high-centimorgan matches than an outbred one, so it crowds his chart out.",
  "shared_with_his_aunt": 3,
  "and_where": "All three of the matches he shares with her sit in ONE of her clusters - the Cape one that holds Butler, Daniel and Daschner.",
  "reading": "The only other tested Lerena contributes three clustered matches to this question, and all three are Cape. This is also the clearest statement yet of why he was never going to separate the lines: he is her NEPHEW, so the Lerena half of him arrives filtered through the same Cape grandmother."
 },
 "the_honest_limit": {
  "floors": {
   "her": 50.6,
   "nephew": 65.0,
   "son": 40.0
  },
  "what_it_means": "AutoClusters only works on matches above a threshold - hers begins at 50.6 cM. A cluster cannot form where nobody has tested, and it cannot form from matches below the floor.",
  "so": "The Croatian clusters on her son's chart exist because Croatians test in numbers. The absence of an Argentine cluster on hers is consistent with Pablo Armando's family having no living tested descendants in either database - which is exactly what the sixty-two-country match census already said, where Argentina did not appear at all.",
  "not_a_disproof": "This is a strong negative and it is not a disproof. It says the answer is not reachable by DNA matching today. It does not say the hypothesis is wrong."
 }
