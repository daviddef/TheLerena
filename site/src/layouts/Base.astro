---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
/* every public asset gets a fingerprint, so a fix is never served stale */
/* THIS CONST MUST STAY BELOW EVERY IMPORT. A statement that reads import.meta.url, placed above a
   later import in Astro frontmatter, breaks the build - and the error is worse than useless: it
   reads Unexpected "{" and points at the plain <meta viewport> tag thirty lines down. Diagnosed
   14 September 2026 by bisecting the frontmatter; moving the line is the whole fix. */
const v = versioner();
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The Lerena Archive";
/* "The families" is a group from 17 October 2026. It was left out until then on purpose: this archive had exactly one
   family page, the Taylors, and a menu group of one implies a section that does not exist. There are now thirteen
   (the Taylors, and the twelve at /families/<slug>/ built from the register by src/lib/families.js and
   data/families.tsv), so the group goes in as the other archives have it, after "Our line". The Taylors moved here from
   "Our line" rather than appearing in both. The labels are the names themselves: that list is also what the landing
   page at defranceski.com reads to show this archive's family pages, so a label must say which family it is. */
const nav = [
  ["Start", [["/", "Home"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/dna/", "The DNA"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/estate/", "The Estate"], ["/passport/", "The Passport"], ["/enrolment-card/", "The Enrolment Card"], ["/name/", "The Name"]]],
  ["The families", [["/families/", "The Families"], ["/taylor/", "The Taylors"], ["/families/brayley/", "Brayley"], ["/families/temple/", "Temple"], ["/families/fernandez/", "Fernandez"], ["/families/pelaez/", "Pelaez"], ["/families/gonzalez/", "Gonzalez"], ["/families/lenguas/", "Lenguas"], ["/families/cardozo/", "Cardozo"], ["/families/juanico/", "Juanico"], ["/families/traibel/", "Traibel"], ["/families/alvarez/", "Alvarez"], ["/families/larriera/", "Larriera"]]],
  ["The work", [["/naairs/", "The Archives"], ["/national-archives/", "The British Archives"], ["/horses/", "The Horses"], ["/argentina/", "Argentina"], ["/uruguay/", "Uruguay"], ["/south-africa/", "South Africa"]]],
  ["People & places", [["/people/", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register/", "The Register"], ["/marriages/", "The Marriages"], ["/places/", "Places"]]],
  ["Evidence", [["/method/", "Method"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/open-questions/", "Open Questions"], ["/errands/", "Errands"], ["/worklist/", "The work list"], ["/corrections/", "Corrections"], ["/changes/", "What changed"]]],
  ["Investigations", [["/hypotheses/", "Hypotheses"], ["/roadmap/", "Roadmap"], ["/family-papers/", "The papers in the house"]]],
];

const here = Astro.url.pathname;
/* WHICH OF THE SEVEN THIS IS — AND IT CANNOT BE THE BASE ANY MORE.
   This used to be ring.archives.find(a => a.base === BASE_URL), which was sound
   while every archive was a project site at /TheX. Since the custom-domain moves
   of 12 October 2026 FIVE archives share base "", and find() returns the FIRST of
   them — the Defranceschi entry. The visible cost here was the ANALYTICS CODE:
   this archive logged every pageview to thedefranceski.goatcounter.com, and its
   own counter stood empty, from the move until this was found. Darcy and Blazevic
   did the same. It is the identical fault the Blazevic session fixed in the kit's
   SocialHead (whoami(), e275c14) — but Base.astro does not go through SocialHead,
   so that fix never reached it.
   THE LOGIC IS INLINED RATHER THAN IMPORTED FROM THE KIT, following TheMazza
   b558bff: kit/lib/ring.js does `import ring from "../data/archives.json"` with no
   `with { type: "json" }`, which Node's ESM loader refuses during static
   generation. SocialHead escapes that only because Vite resolves its relative
   import. Inlining avoids patching the kit and re-pinning seven archives.
   IT MATCHES ON ORIGIN, so astro.config's `site` and this archive's `url` in
   archives.json must agree. Ours do: https://lerena.defranceski.com. */
const originOf = (x) => { try { return new URL(x).origin; } catch { return ""; } };
const SITE_ORIGIN = originOf(import.meta.env.SITE || "");
const onBase = ring.archives.filter(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
const thisArchive =
  (SITE_ORIGIN && onBase.find((a) => originOf(a.url) === SITE_ORIGIN)) || onBase[0];
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek ?? "An evidence-first archive of the Lerena family — Rosario, the Cape, and Brisbane."} />
<SocialHead title={title} description={dek || description} site={SITE} />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Lerena <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first family archive for the Lerena family — of Rosario and the River Plate,
    of the Cape and the Rand, and of Brisbane. Every claim carries its confidence. <strong>A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more.</strong></p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere. Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", function (e) {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
