---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
/* every public asset gets a fingerprint, so a fix is never served stale */
/* THIS CONST MUST STAY BELOW EVERY IMPORT. A statement that reads import.meta.url, placed above a
   later import in Astro frontmatter, breaks the build - and the error is worse than useless: it
   reads Unexpected "{" and points at the plain <meta viewport> tag thirty lines down. Diagnosed
   14 September 2026 by bisecting the frontmatter; moving the line is the whole fix. */
const v = versioner();
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The Lerena Archive";
const nav = [
  ["Start", [["/", "Home"], ["/trees/", "The trees"], ["/tree", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/dna/", "The DNA"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/taylor/", "The Taylors"], ["/estate/", "The Estate"], ["/passport/", "The Passport"], ["/enrolment-card/", "The Card"], ["/name/", "The Name"]]],
  ["The work", [["/naairs/", "The Archives"], ["/horses/", "The Horses"], ["/argentina/", "Argentina"], ["/south-africa/", "South Africa"]]],
  ["People & places", [["/people/", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register/", "The Register"], ["/places/", "Places"]]],
  ["Evidence", [["/hypotheses/", "Hypotheses"], ["/gaps/", "What We Cannot Close"], ["/errands/", "Errands"], ["/photograph-these/", "Photograph These"], ["/roadmap/", "Roadmap"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/open-questions/", "Open Questions"], ["/corrections/", "Corrections"], ["/changes/", "What Changed"], ["/method/", "Method"]]],
];

const here = Astro.url.pathname;
/* which of the seven this is, worked out the same way the ring does */
const thisArchive = ring.archives.find(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek ?? "An evidence-first archive of the Lerena family — Rosario, the Cape, and Brisbane."} />
<SocialHead title={title} description={dek || description} site={SITE} />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Lerena <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first family archive for the Lerena family — of Rosario and the River Plate,
    of the Cape and the Rand, and of Brisbane. Every claim carries its confidence. <strong>Living people appear by name
    only</strong> &mdash; no dates, no places, no photographs.</p>
    <p class="foot dim">Built {new Date().getFullYear()} · Sources listed on <a href={u("/sources/")}>Sources</a> · Everything this archive got wrong is on <a href={u("/corrections/")}>Corrections</a></p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere. Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", function (e) {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
