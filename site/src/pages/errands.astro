---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import { u } from "../lib/url.js";
import rows from "../data/errands.json";
import { emph, plain } from "../lib/text.js";
import Shotlist from "@daviddef/archive-kit/components/Shotlist.astro";
import shots from "../data/photograph-these.json";
import drafts from "../data/letter-drafts.json";
const LABEL = { sent: ["inf", "Sent, awaiting reply"], replied: ["doc", "Answered"],
                "waiting-on-david": ["lore", "Needs a person"],
                ready: ["inf", "Written, not sent"], done: ["doc", "Done"], blocked: ["", "Blocked"] };
/* 21 September 2026. The panel moved to the kit. The GROUPING did not: this
   archive sorts by whether anybody has replied, which is a different question
   from Defranceski's (what would the answer buy) and D'Arcy's (where has the
   request got to). Its Rule ornament stays too, so each group keeps its own
   heading rather than the component's.

   A status LABEL has no entry for used to fall through to "Blocked", which
   quietly relabels an unknown state as a known one. It is counted now. */
const unlabelled = [...new Set(rows.map(r => r.status).filter(k => k && !LABEL[k]))];
const COLOUR = { doc: "#12703F", inf: "#8a7f5c", lore: "var(--terra)", "": "var(--rule-strong)" };
const toRows = (list) => list.map(r => ({
  what: emph(r.what),
  who: r.who + (r.sent_on && r.sent_on !== "-" ? ` · ${r.sent_on}` : ""),
  why: emph(r.detail),
  stateLabel: (LABEL[r.status] || LABEL.blocked)[1],
  colour: COLOUR[(LABEL[r.status] || LABEL.blocked)[0]],
}));

/* 9 October 2026. «Photograph these» folded in here. It is an errand in every field
   the kit's Errands row has: a place, why the picture is worth the trip, what it
   would settle, and nobody asked yet. The difference is only WHO is asked, which
   is anybody standing in Cape Town with a camera, so it keeps its own list
   (ranked by what the picture would settle, with a separate «what to capture» line)
   under its own heading. /photograph-these/ redirects to #photographs. */
const shotGroups = [{
  rows: shots.map((r) => ({
    tag: r.priority, where: r.where, what: emph(r.what), why: emph(r.why_it_matters),
    capture: r.what_to_capture, colour: r.priority === "1" ? "var(--accent)" : null,
  })),
}];
const NUM = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const word = (n) => (n < NUM.length ? NUM[n] : String(n));
const groups = [
  ["Answered", rows.filter(r => r.status === "replied")],
  ["Out, and waiting on a reply", rows.filter(r => r.status === "sent")],
  ["Waiting on a person, not a machine", rows.filter(r => !["sent", "replied", "done"].includes(r.status))],
  ["Closed", rows.filter(r => r.status === "done")],
];
---
<Base title="Errands"
      eyebrow={`${rows.filter(r=>r.status==="replied").length} answered · ${rows.filter(r=>r.status==="sent").length} still out · ${rows.filter(r=>!["sent","replied","done"].includes(r.status)).length} need a person · ${shots.length} places to photograph`}
      dek="What this archive has asked of other archives, and the handful of jobs that need a human being in a particular building. Published so that the waiting is visible rather than invisible.">

<section class="blk" style="margin-top:6px">
  <div class="note"><strong>Five letters are drafted and waiting for you.</strong> Two of them
    cannot go yet &mdash; one has no verified address, one needs a forum account &mdash; and three
    are ready to send. <a href="#s-drafts"><strong>Jump to the letters &darr;</strong></a>
    <span class="cap" style="display:block;margin-top:6px">They are at the very bottom of this
      page, below every errand, which is why this pointer is here.</span></div>
</section>

{groups.map(([title, list]) => list.length > 0 && (
  <>
    <Rule name="arrows" label={title} />
    <section class="blk">
      {/* The labelled Rule above carries this visually; the heading exists so the
          document does not jump h1 -> h3, which tools/audit.py reports. */}
      <h2 class="vh">{title}</h2>
      <Errands groups={[{ rows: toRows(list) }]} u={u} />
    </section>
  </>
))}

{unlabelled.length > 0 && (
  <section class="blk"><p class="small">Filed under a status this page has no label for:
    {unlabelled.join(", ")}.</p></section>
)}

<Rule name="star" label="Photographs only someone there can take" />

<section class="blk" id="photographs">
  <h2 class="vh">Photographs only someone there can take</h2>
  <div class="prose">
    <p>Everything this archive would like a picture of, and cannot take itself. Each says what the
      photograph would settle, and what to capture, because a photograph of the wrong part of a thing is a
      wasted trip. All {word(shots.length)} are in Cape Town, within half an hour of each other.
      <strong>Someone with a morning and a camera could close the first two.</strong></p>
  </div>
  <Shotlist groups={shotGroups} u={u} />
  <div class="note" style="margin-top:20px"><strong>The first one already has a photograph, and it is not enough.</strong> A
    stranger photographed that kerb in 2021 and published it through eGGSA; it shows the surname and no
    more. <a href={u("/south-africa/")}>What the cemetery records say &rarr;</a></div>
</section>

<section class="blk">
  <h2 id="s-drafts">Five letters, drafted and not sent</h2>
  <p class="dek">Written 12 October 2026 and waiting on one person. Copy, change anything that
    does not sound like you, and send them from your own address.</p>
  <div class="prose">
    <p><strong>None of these has been sent, and none of them can be sent by this archive.</strong>
      Anything that leaves here goes from David&rsquo;s own address, which is the standing rule.</p>
    <p><strong>Two of the five cannot go yet, and they say so in red.</strong> The Logro&ntilde;o
      letter has <strong>no verified address</strong> &mdash; this archive does not guess one, and
      the diocese&rsquo;s own site has to supply it first. The RootsChat message has no email at
      all: it needs an account and <strong>two forum posts</strong> before the private-message
      system unlocks. The other three go to addresses already used and already verified.</p>
  </div>
  {drafts.letters.map((d) => (
    <div class="panel" style="margin:20px 0">
      <p style="margin:0 0 6px"><strong set:html={emph(d.title)} /></p>
      <dl class="kv" style="margin:0 0 12px">
        <div><dt>To</dt><dd>{d.to}</dd></div>
        <div><dt>Address</dt><dd>
          {d.address_state === "verified"
            ? <span>{d.address}</span>
            : <strong style="color:#8A2B16">{d.address}</strong>}
        </dd></div>
        <div><dt>Subject</dt><dd><em>{d.subject}</em></dd></div>
        <div><dt>Written in</dt><dd>{d.lang}</dd></div>
        <div><dt>Why</dt><dd set:html={emph(d.why)} /></div>
      </dl>
      <pre style="white-space:pre-wrap;font-family:inherit;font-size:16.5px;line-height:1.6;margin:0;padding:18px 22px;background:rgba(0,0,0,.03);border-radius:4px;overflow-wrap:break-word">{d.body}</pre>
    </div>
  ))}
  <p class="cap" style="margin-top:14px"><strong>Why three of them are chasers.</strong> The
    Cancillería and the Ej&eacute;rcito were written to on 9 and 8 September and have not answered
    in five weeks; the Western Cape letter was answered in part, from David&rsquo;s own files rather
    than by the archive, so what it asks for now is different &mdash; the will of 6 February 1942
    and the inventory, not the death notice.</p>
</section>

<section class="blk">
  <p class="cap">Every letter&rsquo;s full text is kept in <span class="mono">requests/</span> in the
    repository, with the address it went to and how that address was verified &mdash; never guessed.
    <a href={u("/sources/")}>Sources &rarr;</a></p>
</section>
</Base>
