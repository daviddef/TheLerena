---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import rows from "../data/errands.json";
const LABEL = { sent: ["inf", "Sent, awaiting reply"], replied: ["doc", "Answered"],
                "waiting-on-david": ["lore", "Needs a person"],
                ready: ["inf", "Written, not sent"], blocked: ["", "Blocked"] };
const groups = [
  ["Answered", rows.filter(r => r.status === "replied")],
  ["Out, and waiting on a reply", rows.filter(r => r.status === "sent")],
  ["Waiting on a person, not a machine", rows.filter(r => !["sent", "replied"].includes(r.status))],
];
---
<Base title="Errands"
      eyebrow={`${rows.filter(r=>r.status==="replied").length} answered · ${rows.filter(r=>r.status==="sent").length} still out · ${rows.filter(r=>!["sent","replied"].includes(r.status)).length} need a person`}
      dek="What this archive has asked of other archives, and the handful of jobs that need a human being in a particular building. Published so that the waiting is visible rather than invisible.">

{groups.map(([title, list]) => list.length > 0 && (
  <>
    <Rule name="arrows" label={title} />
    <section class="blk">
      {list.map(r => (
        <div class="panel" style="margin-top:18px">
          <div class="lab">{r.who}{r.sent_on && r.sent_on !== "-" ? ` · ${r.sent_on}` : ""}</div>
          <p style="margin:10px 0 0;font-size:1.05rem"><strong>{r.what}</strong></p>
          <p class="cap" style="margin:10px 0 0">{r.detail}</p>
          <div style="margin-top:12px">
            <span class={`chip ${(LABEL[r.status] || LABEL.blocked)[0]}`.trim()}>
              {(LABEL[r.status] || LABEL.blocked)[1]}</span>
          </div>
        </div>
      ))}
    </section>
  </>
))}

<section class="blk">
  <p class="cap">Every letter&rsquo;s full text is kept in <span class="mono">requests/</span> in the
    repository, with the address it went to and how that address was verified &mdash; never guessed.
    <a href={u("/sources/")}>Sources &rarr;</a></p>
</section>
</Base>
