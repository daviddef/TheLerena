---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Timeline from "@daviddef/archive-kit/components/Timeline.astro";
import { u } from "../lib/url.js";
import rows from "../data/timeline.json";
import { emph, plain } from "../lib/text.js";
const KIND = { life: ["doc", "Life"], document: ["inf", "Document"], context: ["lore", "The world"] };
const span = [rows[0].year, rows[rows.length - 1].year];
const events = rows.map((r) => ({
  year: r.year,
  when: r.date && r.date !== "-" ? r.date : String(r.year),
  title: emph(r.what),
  kind: (KIND[r.kind] || KIND.life)[1],
  source: emph(r.source),
}));
---
<Base title="The Timeline"
      eyebrow={`${span[0]}–${span[1]} · ${rows.length} fixed points`}
      dek="Every dated thing this archive can stand behind, in order, with the record it rests on — and the handful of world events that explain why a Rosario horseman was at the Cape at all.">

<Rule name="horse" label="From Rosario to Newlands" />

<Timeline events={events} u={u} noun="fixed points" />

<section class="blk">
  <div class="note"><strong>The gap that shapes the page.</strong> Between his birth at Rosario in 1882
    and his eldest son&rsquo;s birth at Cape Town in 1905 there are <strong>twenty-three years with
    nothing in them</strong> &mdash; and the only plausible bridge this archive has found is the
    remount trade of 1899&ndash;1902. <a href={u("/horses/")}>The horses &rarr;</a></div>
</section>
</Base>
