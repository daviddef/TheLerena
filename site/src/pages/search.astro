---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";
import idx from "../data/searchindex.json";

const hints = [
  ["Rosario", "the river city he was born in"],
  ["Trainer", "the one word under 'profession' on his passport"],
  ["Lerena", "one of the rarest surnames on earth"],
  ["Taylor", "Mary Septima, the seventh daughter"],
  ["Wynberg", "the parish that answered"],
  ["1882", "the year Bob was born"],
];
---
<Base title="Search" eyebrow={`${idx.length.toLocaleString()} things, one box`}
      dek="Every page, every person and every record this archive holds — searched together.">
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Rosario · Trainer · Wynberg · 1882 · Septima" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
