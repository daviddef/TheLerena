          <td>Cordón, Montevideo</td><td>Roque Vicente Granero &amp; Rosa María Llerena</td></tr>
        <tr><td><strong>Pablo Evaristo Lerena Harrison</strong></td><td class="m">m. 1902</td>
          <td><strong>Flores</strong></td><td>Pio C. Lerena &amp; Bernardina Harrison</td></tr>
        <tr><td>Pedro Pablo Lerena</td><td class="m">b. 6 Aug 1910</td><td>Montevideo</td>
