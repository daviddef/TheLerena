---
import Base from "../layouts/Base.astro";
import Corrections from "@daviddef/archive-kit/components/Corrections.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import rows from "../data/corrections.json";
import { emph, plain } from "../lib/text.js";
const serious = rows.filter(r => r.severity === "serious").length;
const minor = rows.length - serious;
const byDate = [...rows].sort((a, b) => b.date.localeCompare(a.date));
const MONTHS = ["January","February","March","April","May","June",
                "July","August","September","October","November","December"];
const pretty = (d) => { const [y, m, day] = d.split("-");
  return `${Number(day)} ${MONTHS[Number(m) - 1]} ${y}`; };
const dayId = (d) => "c-" + d;
const days = [...new Set(byDate.map(r => r.date))]
  .map(d => ({ date: d, rows: byDate.filter(r => r.date === d) }));
---
<Base title="Corrections"
      eyebrow={`${rows.length} entries · ${serious} serious`}
      dek="Every claim this archive has published, or was about to publish, and then had to take back. It is the most useful page here, because an archive that never corrects itself is only telling you what it wanted to be true.">

<section class="blk">
  <div class="prose">
    <p>Genealogy fails in one direction. A wrong name, once written down, gets copied; a right name only
      gets found. So this page exists to make the wrongness expensive &mdash; every retraction is dated,
      graded, and says <strong>how it was caught</strong>, because the catching is the transferable part.</p>
    <p><strong>Nothing here has been quietly edited away.</strong> Where a page elsewhere on this site
      once said something different, it now says the corrected thing <em>and</em> says that it used to say
      something else.</p>
  </div>
  <div class="grid g3" style="margin-top:22px">
    <div class="panel"><div class="nm">{rows.length}</div><div class="txt">corrections recorded</div></div>
    <div class="panel"><div class="nm">{serious}</div><div class="txt">serious &mdash; changed a conclusion</div></div>
    <div class="panel"><div class="nm">{minor}</div><div class="txt">minor &mdash; a slip, corrected</div></div>
  </div>
</section>

<section class="blk">
  <h2 id="contents">Every one of them, by the day it was caught</h2>
  <div class="prose" style="margin-top:12px">
    <ol class="cols2">
      {days.map(d => (
        <li><a href={"#" + dayId(d.date)}>{pretty(d.date)}</a>
          <span class="cap"> &mdash; {d.rows.length} {d.rows.length === 1 ? "correction" : "corrections"},
            {" "}{d.rows.filter(r => r.severity === "serious").length} serious</span></li>
      ))}
    </ol>
  </div>
</section>

<section class="blk">
  <Corrections u={u} rows={byDate.map((r, i) => ({
    /* The contents list above links to one anchor per DAY. Give that id to the
       FIRST correction of each day - otherwise every link on this page points at
       an id that is never rendered, which is what check-links found on
       16 September 2026. */
    id: (i === 0 || byDate[i - 1].date !== r.date) ? dayId(r.date) : undefined,
    when: pretty(r.date),
    sev: r.severity,
    was: emph(r.what_was_said),
    now: emph(r.what_is_true),
    how: emph(r.how_it_was_caught),
  }))} major="serious" />
</section>

<section class="blk">
  <div class="note"><strong>Found something else wrong?</strong> That is the most valuable thing anyone can
    send. Corrections go straight onto this page with the date and the reason.
    <a href={u("/sources/")}>Sources &rarr;</a></div>
</section>
</Base>
