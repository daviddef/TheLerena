---
import Base from "../layouts/Base.astro";
import Changes from "@daviddef/archive-kit/components/Changes.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import data from "../data/changes.json";
import { emph } from "../lib/text.js";
const days = data.days;
const mechanical = data.mechanical;
const total = days.reduce((n, d) => n + d.commits.length, 0);
const REPO = "https://github.com/daviddef/TheLerena/commit/";
const dayId = (d) => "d-" + d;
const pretty = (d) => {
  const [y, m, day] = d.split("-");
  const MONTHS = ["January","February","March","April","May","June",
                  "July","August","September","October","November","December"];
  return `${Number(day)} ${MONTHS[Number(m) - 1]} ${y}`;
};
---
<Base title="What changed"
      eyebrow={`${total} changes across ${days.length} ${days.length === 1 ? "day" : "days"}`}
      dek="The whole history of this archive, newest first, in the words used at the time. Nothing here is written for the page — it is the working log, published.">

<section class="blk">
  <div class="prose">
    <p>Every change to this archive is committed with <strong>the reason, not just the result</strong>.
      That habit costs nothing at the time and is worth a great deal later: it means the record of
      <em>why</em> a thing was believed survives alongside the thing itself.</p>
    <p>So this page is not a summary. It is <strong>the log</strong>, rendered. Where a day contains a
      retraction it will say so in its own words, and the same retraction is graded and dated on
      <a href={u("/corrections/")}>Corrections</a>.</p>
    <p class="cap">Each entry shows its subject line; the reasoning underneath opens on a click, because
      the full log runs to some thirty thousand words and nobody should have to scroll past all of it to
      reach a particular day. {mechanical} further commits are <strong>omitted</strong>: their whole
      subject is <em>&ldquo;Rebuild the changelog&rdquo;</em>, they are the mechanical consequence of the
      commit before them, and they contain no reasoning. They are counted here rather than quietly
      dropped. Every commit, mechanical or not, is in
      <a href="https://github.com/daviddef/TheLerena/commits/main" rel="noopener">the repository &#8599;</a>.</p>
  </div>
</section>

<section class="blk">
  <h2 id="contents">The days</h2>
  <div class="prose" style="margin-top:12px">
    <ol class="cols2">
      {days.map(d => (
        <li><a href={"#" + dayId(d.date)}>{pretty(d.date)}</a>
          <span class="cap"> — {d.commits.length} {d.commits.length === 1 ? "change" : "changes"}</span></li>
      ))}
    </ol>
  </div>
</section>

<section class="blk">
  <Changes u={u} days={days.map(d => ({
    when: pretty(d.date),
    id: dayId(d.date),
    entries: d.commits.map(c => ({
      title: emph(c.subject),
      did: emph(c.body ? c.body.replace(/\n/g, " ") : ""),
    })),
  }))} />
</section>
</Base>
