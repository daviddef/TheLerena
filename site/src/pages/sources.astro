---
import Base from "../layouts/Base.astro";
import Sources from "@daviddef/archive-kit/components/Sources.astro";
import { u } from "../lib/url.js";
import { emph } from "../lib/text.js";
import consulted from "../data/sources-consulted.json";

// A document opened here outranks an index that merely mentions one. The tier is carried
// in the data so the distinction survives on the page.
const TIER = { PRIMARY: "doc", SECONDARY: "inf", REFERENCE: "lore" };
const primary = consulted.filter(r => r.tier === "PRIMARY").length;

/* 21 September 2026. The table is the kit's source rows now, and the TIER is
   split where it is read rather than where it is stored.

   `tier` holds two facts in one string. There are three tiers and twenty-six
   distinct values, because a qualifier has been concatenated onto the tier
   with a dash — "PRIMARY - full-text transcript read", "SECONDARY - a
   negative result, controlled". Printed whole, as this page did, the chip
   says something true and cannot be counted, filtered or compared with any
   other archive's grading.

   So the tier before the dash becomes the group and the qualifier after it
   becomes the row's tag, which is what the component's tag slot exists for.
   THE DATA FILE IS UNCHANGED. Splitting the column properly is this
   archive's decision to make in data/sources-consulted.tsv, not one to take
   in a template; this only stops the page presenting a compound value as if
   it were an atom. */
const ORDER = ["PRIMARY", "SECONDARY", "REFERENCE"];
const BOTH = "Graded two ways";

/* Two of the 121 name TWO tiers in one field — "SECONDARY for the marriage
   index; PRIMARY for the Madrid and Cordoba full-text" — which is a true
   statement about a source used for two different things and is not a
   grade. Splitting on the dash made each of them its own group of one,
   which looked like five tiers where there are three. They get a bucket
   that says what they are, and their whole tier string as the tag. */
const split = (t) => {
  const raw = String(t || "").trim();
  const [head, ...rest] = raw.split(/\s+[-\u2014]\s+/);
  const h = head.trim();
  if (!ORDER.includes(h)) return [BOTH, raw];
  return [h, rest.join(" — ").trim()];
};
const seen = [...new Set(consulted.map(r => split(r.tier)[0]))];
const tiers = [...ORDER.filter(t => seen.includes(t)), ...seen.filter(t => !ORDER.includes(t))];
const twoWays = consulted.filter(r => split(r.tier)[0] === BOTH).length;
const GLOSS = {
  PRIMARY: "a document image opened and read here",
  SECONDARY: "an index, a user-built tree or a published account",
  REFERENCE: "background, consulted for a particular fact",
  [BOTH]: "one source doing two jobs, and the field says both rather than choosing",
};
const groups = tiers.map(t => ({
  label: t, note: GLOSS[t],
  rows: consulted.filter(r => split(r.tier)[0] === t).map(r => ({
    title: emph(r.source), url: r.link, what: emph(r.used_for),
    tag: split(r.tier)[1] || null, where: r.accessed,
  })),
})).filter(g => g.rows.length);
const reach = consulted.filter(r => r.link).length;
---
<Base title="Sources"
      eyebrow="Consulted, and identified but not yet consulted"
      dek="Everything consulted so far, and everything identified as needing to be consulted. The second list is still the longer of the two, and that is the point of publishing it.">
<section class="blk">
<h2>Consulted</h2>
  <p class="dek">Generated from <span class="m">data/sources-consulted.tsv</span>, so this table cannot
    fall behind the work. It did once: it sat unchanged from 10 to 13 September 2026 while three days of
    reading went unrecorded, under a heading claiming to list everything. <strong>{primary}</strong> of
    these are PRIMARY &mdash; a document image opened and read here; the rest are indexes, user-built
    trees, published accounts and background.</p>
  <p class="note"><strong>{reach} of the {consulted.length} say where they are; {consulted.length - reach} do not.</strong>
    That is the largest such gap in this estate, and it is on this page rather than in a report so
    that it shrinks.</p>
  <p class="cap"><strong>The tier column holds two facts in one string.</strong> Three tiers, and
    twenty-six distinct values, because a qualifier is concatenated onto the tier with a dash. The
    tier groups these rows and the qualifier is shown beside each; {twoWays} rows name two tiers at
    once and are kept together rather than split. <strong>The data file is unchanged</strong> —
    separating the column belongs in <span class="mono">data/sources-consulted.tsv</span>.</p>
  <div style="margin-top:20px"><Sources groups={groups} u={u} /></div>
</section>

<section class="blk">
<h2>Identified, not yet consulted</h2>
  <h3>Argentina and Uruguay</h3>
  <ul>
    <li>Civil registration, <strong>Santa Fe</strong> province (Rosario), from the 1880s.</li>
    <li>Catholic parish registers, <strong>Archdiocese of Rosario</strong>, via FamilySearch.</li>
    <li><strong>CEMLA</strong> immigrant database and the <em>listas de pasajeros</em> into Buenos Aires.</li>
    <li><strong>Boletín Oficial de la República Argentina</strong> — consular appointments.</li>
    <li>Argentine <strong>Ministerio de Relaciones Exteriores</strong> <em>Memorias</em> and diplomatic lists.</li>
    <li><strong>Argentine Stud Book</strong> — Lerena entries as owner and breeder; Haras El Viejo.</li>
    <li>Uruguayan civil and parish registers, <strong>Montevideo</strong>.</li>
  </ul>
  <h3>South Africa</h3>
  <ul>
    <li><strong>NAAIRS</strong> — deceased estate files, wills, departmental records. Highest-value target.</li>
    <li>Civil registration; Department of Home Affairs and the provincial archives.</li>
    <li><strong>Union of South Africa Government Gazette</strong> and Cape Colony gazettes — the
      <em>exequatur</em> recognising a foreign consul.</li>
    <li><strong>South African Stud Book</strong> and Jockey Club registers, including imports.</li>
    <li><strong>C.P. Nel Museum</strong>, Oudtshoorn, and the Cape archives — the ostrich feather trade.</li>
    <li>Cape and Rand newspapers.</li>
  </ul>
  <h3>Spain</h3>
  <ul>
    <li><strong>INE</strong> provincial surname distribution — to test La Rioja against Badajoz.</li>
    <li>Parish and civil registers in whichever province the emigration record eventually names.</li>
  </ul>
  <h3>The family's own records</h3>
  <ul>
    <li>David Defranceski's <strong>MyHeritage tree</strong>, with its stored facts, citations and media.
      Not yet read into this archive.</li>
    <li>Australian records for the Johannesburg-to-Brisbane migration, subject to the rule on living people.</li>
  </ul>
</section>

<section class="blk">
  <h2>Every collection searched, with its link</h2>
  <p class="dek">So that any claim on this site can be checked, and any search repeated, without guessing
    where it was made.</p>

  <h3 style="margin-top:26px">The Rosario films</h3>
  <div class="scroll" style="margin-top:14px">
    <table>
      <thead><tr><th>Film</th><th>What it is</th><th>Used for</th></tr></thead>
      <tbody>
        <tr><td class="m"><a href="https://www.familysearch.org/search/film/004530325">DGS 4530325</a></td>
          <td>Índice de bautismos, Nuestra Señora del Rosario, 1879–1900</td>
          <td>The three-year sweep: every letter, 1881–83</td></tr>
        <tr><td class="m"><a href="https://www.familysearch.org/search/film/004531041">DGS 4531041</a></td>
          <td>Matrimonios 1884–1891 (Libro 9 onward)</td>
          <td>All of 1884 read act by act</td></tr>
        <tr><td class="m"><a href="https://www.familysearch.org/search/film/004531040">DGS 4531040</a></td>
          <td>Matrimonios 1868–1884 (Libro 8)</td>
          <td>Answered from the search index, with a control</td></tr>
        <tr><td class="m"><a href="https://www.familysearch.org/search/film/004531036">DGS 4531036</a></td>
          <td>Índice de matrimonios 1731–1761, 1860–1921</td>
          <td>Where the Lavena candidate came from</td></tr>
        <tr><td class="m"><a href="https://www.familysearch.org/search/film/004331984">Film 004331984</a></td>
