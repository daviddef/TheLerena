---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { emph } from "../lib/text.js";
import routes from "../data/three-routes-walked.json";
import letter from "../data/letter-registro-civil-santafe.json";
import Spine from "@daviddef/archive-kit/components/Spine.astro";

/* Every Lerena Argentina can actually produce, and where each one came from.
   Three households, three arrows back across the river — and one man with no
   arrow at all. Drawn rather than argued, because the pattern is the point. */
const rosario1866 = [
  { gen: "1", name: "Luis Lerena Lenguas", spouse: "Julia Juanico",
    bornPlace: "Uruguay", confidence: "Documented",
    note: `<span class="cap">The act calls them <em>&ldquo;naturales del E[stado] Oriental&rdquo;</em> \u2014 natives of Uruguay, in the clerk\u2019s own hand.</span>` },
  { gen: "2", name: "Their daughter", confidence: "Documented",
    note: `<span class="cap">Born 8 October 1865, baptised at Rosario 17 February 1866, act 1541. <strong>The only Lerena in the Rosario baptism index between 1731 and 1901</strong> \u2014 and she is Uruguayan on both sides.</span>` },
];
const gilbertoLine = [
  { gen: "1", name: "Gilberto Justiniano Lerena Lenguas",
    born: "1854", bornPlace: "Uruguay", confidence: "Documented",
    note: `<span class="cap">Co-founder of the <strong>Argentine Stud Book</strong>; a Group 1 at Palermo was renamed for him in 1914.</span>` },
  { gen: "2", name: "His Buenos Aires household", confidence: "Documented",
    note: `<span class="cap">The <strong>1895 national census</strong>, Secci\u00f3n 21, Ciudad de Buenos Aires. The elder children are born <strong>Uruguay</strong>, the younger ones <strong>Buenos Aires</strong> \u2014 the crossing is legible in one household.</span>` },
];
const alejandroLine = [
  { gen: "1", name: "Alejandro M. Lerena", spouse: "Julia Bassani",
    born: "1839", bornPlace: "Uruguay", confidence: "Documented",
    note: `<span class="cap">Born Uruguay, and the Argentine army record confirms it independently.</span>` },
  { gen: "2", name: "His sons, in the same drawer", confidence: "Documented",
    note: `<span class="cap">Enrolment cards in <strong>Caj\u00f3n 985</strong>: Hector born <strong>Montevideo 1886</strong>, Roberto Juan <strong>Misiones 1891</strong>, Romer Rosario <strong>Buenos Aires 1895</strong>. <strong>One family, five spellings of the surname</strong> \u2014 and the same drawer that holds Pablo Armando\u2019s card.</span>` },
];
const pabloLine = [
  { gen: "1", name: "Juan Carlos Lerena", spouse: "Mar\u00eda Lerena",
    bornPlace: "not known", confidence: "Documented",
    weak: true, weakNote: "Named by their son on <a href=\"/TheLerena/enrolment-card/\">his enrolment card</a> and <strong>nowhere else on earth</strong>. No baptism, no marriage, no burial, in Argentina or Uruguay.",
    note: `<span class="cap">No arrow back across the river, because there is no record to draw one from.</span>` },
  { gen: "2", name: "Pablo Armando Lerena",
    born: "22 February 1882", bornPlace: "Rosario de Santa Fe",
    died: "19 March 1950", diedPlace: "Newlands, Cape Town", confidence: "Documented",
    note: `<span class="cap">His own passport gives the town and the day. <strong>And the Rosario registers, read to exhaustion, do not hold him.</strong></span>` },
];
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
/* The plate appears the moment the file is dropped in; the page is fine without it. */
const ART = "/art/rosario-parana.webp";
/* WARNING, and it cost a build on 17 September 2026. hasArt reads import.meta.url, and in Astro
   frontmatter ANY statement that does so must sit BELOW every import - put an import after it and
   the build dies with "Unexpected <name>" pointing at a line seventy lines away that is fine.
   Base.astro carries the same warning for the same reason. New imports go at the TOP. */
const hasArt = fs.existsSync(
  path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "..", "public", ART)
);
---
<Base title="Argentina"
      eyebrow="Rosario, Santa Fe — and the records that do not answer"
      dek="Rosario is the place the family names, and its records survive and are reachable. They have now been searched to exhaustion, and he is not in them — which is a finding, not a failure.">

{hasArt && (
  <figure class="wideplate">
    <img src={u(ART)} loading="lazy" decoding="async"
         alt="A painted impression of the high bank of the Paraná at Rosario in the 1880s: low whitewashed buildings along the bluff, a timber corral with criollo horses, and a small steamer far out on the water." />
    <figcaption class="cap">A modern painted impression, not a photograph, and not a view of any place
      this family is documented at. It stands for what the passport asserts and the registers have not yet
      confirmed — Rosario on the Paraná, the horses, and a boat on the water.</figcaption>
  </figure>
)}

<section class="blk">

<div class="panel" style="margin:1.4rem 0">
    <p style="margin-top:0"><span class="chip doc">Confirmed, 8 September 2026</span></p>
    <p style="margin-bottom:0">
      <strong>Pablo Armando Lerena was born at Rosario de Santa Fe on 22 February 1882</strong>, and was
      Argentine by birth, not naturalised — from the passport he carried, signed and thumb-printed.
      The page below was written before that document surfaced. The tradition it describes was correct.
      <a href={u("/passport/")}>The passport &rarr;</a>
    </p>
  </div>
</section>

<section class="blk">
  <h2 id="contents">What is on this page</h2>
  <p class="dek">From what the family claimed to where the records actually are. The build checks this list against the page, so a section cannot be added or
    renamed without appearing here.</p>
  <div class="prose" style="margin-top:14px">
    <ol class="cols2">
      <li><a href="#s-what-was-claimed">What was claimed</a></li>
      <li><a href="#s-why-rosario-is-plausible">Why Rosario is plausible</a></li>
      <li><a href="#s-uruguay-is-not-a-detour">Uruguay is not a detour</a></li>
      <li><a href="#s-where-the-records-are">Where the records are</a></li>
      <li><a href="#s-the-consul-how-it-gets-proved">The consul: how it gets proved</a></li>
      <li><a href="#s-what-this-page-needs-next">What this page needs next</a></li>
      <li><a href="#s-the-1895-census-a-lerena-household-and-it-is-not-his">The 1895 census: a Lerena household, and it is not his</a></li>
      <li><a href="#s-every-lerena-argentina-can-produce">Every Lerena Argentina can produce, drawn</a></li>
      <li><a href="#s-three-refusals-and-one-direction">Three refusals, and one direction</a></li>
      <li><a href="#s-where-to-go-next">Where to go next</a></li>
      <li><a href="#s-the-registers-now-searched-to-the-end">The registers, now searched to the end</a></li>
      <li><a href="#s-the-surname-in-rosario-at-last-but-the-wrong-man-and-the-wro">The surname in Rosario, at last — but the wrong man and the wrong century</a></li>
      <li><a href="#s-which-rosario">Which Rosario?</a></li>
          <li><a href="#s-three-routes">The last three routes, walked</a></li>
      <li><a href="#s-letter">The letter to the Registro Civil, and why the ask changed</a></li>
</ol>
  </div>
</section>


<section class="blk">
<h2 id="s-what-was-claimed">What was claimed</h2>
  <p>
    <span class="chip lore">Family testimony</span> David Defranceski's great-grandfather — the grandfather
    of <strong>Cheryl Anne Lerena</strong> — came from Argentina, and <strong>Rosario</strong> is the city
    associated with him. He is said to have gone to South Africa as <strong>Consul General</strong>.
  </p>
  <p>
    No name, no dates and no document are attached to this yet. Establishing the name is the first task of
    the archive, and everything else waits on it.
  </p>
</section>
<section class="blk">
<h2 id="s-why-rosario-is-plausible">Why Rosario is plausible</h2>
  <p>
    <span class="chip doc">Documented</span> The name's distribution supports the story independently of
    the story. <strong>Argentina holds 293 Lerenas and Uruguay 431</strong> — and Uruguay's density,
    1 in 7,962, is the highest in the world. The <strong>River Plate is the modern heartland of the
    surname</strong>. A family tradition pointing to Argentina is pointing exactly where the name actually
    concentrates, which is a modest but real corroboration. <a href={u("/name/")}>The name &rarr;</a>
  </p>
  <p>
    Rosario itself fits the period. Argentina's second city and the great grain port of the Paraná, it grew
    through the late nineteenth and early twentieth centuries on European immigration and on the pampas
    trade — cattle, grain, and <strong>horses</strong>. A family with standing enough to produce a consul,
    and interests in bloodstock, is a recognisable Rosario type of that era.
  </p>
</section>
<section class="blk">
<h2 id="s-uruguay-is-not-a-detour">Uruguay is not a detour</h2>
  <p>
    The River Plate is one social world with a border through it, and families crossed it constantly.
    Given that <strong>Uruguay has the densest Lerena population on earth</strong>, and that the Argentine
    Stud Book's co-founder carried the Uruguayan double surname <strong>Lerena Lenguas</strong>, the
    archive treats <strong>Montevideo as a live possibility from the outset</strong>, not as a fallback
    after Argentina fails.
  </p>
  <p class="cap">
    Stated plainly so it is not forgotten later: if the Argentine search stalls, the correct next move is
    Uruguay, not a harder Argentine search.
  </p>
  <div class="panel" style="border-left:3px solid var(--accent);margin-top:20px">
    <p class="lab" style="margin:0 0 8px">13 September 2026 &mdash; that instruction was followed, and it
      paid</p>
    <div class="prose">
      <p>The Argentine search did stall, and the next move was Uruguay. Both volumes of the Rosario
        baptism index were read end to end: <strong>one Lerena in a hundred and seventy years</strong>,
        and the act behind her says of both parents <em><strong>&ldquo;naturales del E.
        Oriental&rdquo;</strong></em>.</p>
      <p>The measurement bears it out too. In the full-text corpus <strong>LERENA runs
        6.4&times; commoner in Uruguay than Argentina</strong>, while its twin <strong>LLERENA runs
        3.6&times; the other way</strong> &mdash; and two reference surnames measured the same way both
        favour Argentina. <em>Lerena</em> is the only one of the four that reverses, and it is the
        spelling this family used.</p>
      <p><strong>What it has not produced is Juan Carlos.</strong> The one documented Lerena household of
        that generation in the River Plate is now open from its marriage act to its last burial, and he
        is not in it. <a href={u("/hypotheses/")}>Hypothesis 1c &rarr;</a> &middot;
        <a href={u("/searched/")}>What was read &rarr;</a></p>
    </div>
  </div>
</section>
<section class="blk">
<h2 id="s-where-the-records-are">Where the records are</h2>
  <p>These are the seams to work, in the order they are worth working.</p>

  <div class="grid g2">
    <div class="panel">
      <h3 style="margin-top:0">Civil registration, Santa Fe province</h3>
      <p style="margin-bottom:0">
        Argentina's civil registration begins in the 1880s. Rosario sits in <strong>Santa Fe</strong>
        province. Births, marriages and deaths from that point should name parents outright — the single
        most efficient way up a generation.
      </p>
    </div>
    <div class="panel">
      <h3 style="margin-top:0">Catholic parish registers</h3>
      <p style="margin-bottom:0">
        Before civil registration, and alongside it, the parishes. Rosario's older parishes and the
        Archdiocese of Rosario hold baptisms, marriages and burials; many are filmed by FamilySearch.
      </p>
    </div>
    <div class="panel">
      <h3 style="margin-top:0">Immigration and passenger records</h3>
      <p style="margin-bottom:0">
        The <strong>CEMLA</strong> immigrant database and the Argentine <em>listas de pasajeros</em> record
        arrivals into Buenos Aires with age, origin, occupation and often the town in Spain. If the family
        arrived from Spain in the emigration century, this is where the Iberian origin is named.
      </p>
    </div>
    <div class="panel">
      <h3 style="margin-top:0">Outbound to South Africa</h3>
      <p style="margin-bottom:0">
        The departure matters as much as the arrival. A consular posting leaves a paper trail at both ends —
        see <a href={u("/south-africa/")}>South Africa</a>.
      </p>
    </div>
  </div>
</section>
<section class="blk">
<h2 id="s-the-consul-how-it-gets-proved">The consul: how it gets proved</h2>
  <p>
    A Consul General is a public officer, and public officers are published. This claim should be among the
    <em>easiest</em> in the archive to settle, once a name exists:
  </p>
  <ul>
    <li>The Argentine <strong>Ministerio de Relaciones Exteriores</strong> published annual
      <em>Memorias</em> and diplomatic lists naming every consular officer and post.</li>
    <li>The <strong>Boletín Oficial</strong> of the Argentine Republic records appointments.</li>
    <li>On the receiving side, South African and British colonial <strong>government gazettes</strong>
      published the grant of an <em>exequatur</em> — the host state's formal recognition of a foreign
      consul. This is the crispest single document available, and it is dated.</li>
    <li>Contemporary newspapers on both sides reported consular arrivals and social life. Argentine and
      South African digitised press are both searchable.</li>
  </ul>
  <p>
    Note one caution to carry from the start: <strong>consuls were often honorary</strong>. A merchant
    resident in the host country could hold the post. If the great-grandfather was an honorary consul
    rather than a career diplomat, he may appear in the gazettes but not in the Argentine foreign-service
    lists — and that would also explain a man who bred horses and farmed ostriches while holding a
    diplomatic title. <span class="chip inf">A hypothesis, recorded early so it can be tested</span>
  </p>
</section>
<section class="blk">
<h2 id="s-what-this-page-needs-next">What this page needs next</h2>
  <p>
    <strong>His parents.</strong> The name, the city and the day are known — Pablo Armando Lerena,
    Rosario, 22 February 1882. Who his father and mother were is not.
    <strong>The baptism that would have named them has been looked for and is not there</strong>: three
    years of the index, every letter, any surname. That route is <em>exhausted</em>, not merely
    unsuccessful, and should not be reopened without a new reason.
    <a href={u("/searched/")}>What has been searched &rarr;</a> &middot;
    <a href={u("/open-questions/")}>Open questions &rarr;</a>
  </p>
</section>
<section class="blk">
  <h2 id="s-the-1895-census-a-lerena-household-and-it-is-not-his">The 1895 census: a Lerena household, and it is not his</h2>
  <p class="dek">The Argentine national census of 1895 is indexed and searchable. It answers a different
    question from the one it was asked.</p>
  <p style="margin-top:18px"><span class="chip doc">Documented</span> One substantial Lerena household
    appears, in <strong>Buenos Aires, Sección 21, Subdivisión 15</strong>:</p>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th>Name</th><th class="m">Age</th><th class="m">Born</th><th>Birthplace</th></tr></thead>
      <tbody>
        <tr><td><strong>Gilberto Lerena</strong> <span class="cap">head, married</span></td><td class="m">41</td><td class="m">1854</td><td><strong>Uruguay</strong></td></tr>
        <tr><td>Maria E. C.</td><td class="m">26</td><td class="m">1869</td><td>Uruguay</td></tr>
        <tr><td>Maria Luisa</td><td class="m">15</td><td class="m">1880</td><td>Uruguay</td></tr>
        <tr><td>Carlos A.</td><td class="m">11</td><td class="m">1884</td><td>Uruguay</td></tr>
        <tr><td>Raul A.</td><td class="m">9</td><td class="m">1886</td><td>Uruguay</td></tr>
        <tr><td>Maria A.</td><td class="m">8</td><td class="m">1887</td><td>Uruguay</td></tr>
        <tr><td>Maria C.</td><td class="m">6</td><td class="m">1889</td><td><strong>Buenos Aires</strong></td></tr>
        <tr><td>Maria E.</td><td class="m">5</td><td class="m">1890</td><td>Buenos Aires</td></tr>
        <tr><td>Luis F.</td><td class="m">2</td><td class="m">1893</td><td>Buenos Aires</td></tr>
      </tbody>
    </table>
  </div>
  <p style="margin-top:20px">
    Uruguayan records already give <strong>Gilberto Lerena</strong> married to <strong>Julia
    Salvañach</strong>, with sons <strong>Carlos Augusto Federico</strong> (born Montevideo, 1883) and
    <strong>Raul</strong> (1885). Here they are, in Buenos Aires, ten years on.
  </p>
  <p style="margin-top:14px">
    <span class="chip inf">Inferred</span> So the co-founder of the <a href={u("/horses/")}>Argentine Stud
    Book</a> was a <strong>Uruguayan</strong>, born 1854 — which fits a Group 1 race being renamed in his
    honour in 1914, at or just after his death. And the children's birthplaces date the family's crossing
    precisely: <strong>Uruguay through 1887, Buenos Aires from 1889</strong>.
  </p>
  <p style="margin-top:20px">
    <span class="chip doc">Documented</span> A <strong>second Gilberto</strong> sits just outside this
    table, and he is worth naming because he is the closer match on every axis except the one that counts.
    On <strong>27 February 1928</strong> a <strong>Gilberto Lerena born 1879</strong> landed at Buenos Aires
    aboard the <em>Cap Norte</em>, travelling as an <strong>Argentine national</strong> and accompanied by a
    son of the same name. He was born within three years of Pablo Armando, and he carries the
    <strong>Gilberto</strong> forename of the Stud Book family above.
  </p>
  <p style="margin-top:14px">
    <span class="chip inf">Inferred</span> And yet he is <strong>not in the 1895 household</strong> &mdash;
    not as a son of Gilberto (1854), who was then 41 with children born from 1880, nor anywhere else in that
    return. So the name recurs in a family this archive can see, in a generation it cannot place him in.
    He is recorded here as an <em>unresolved namesake</em>, not as a relative: an Argentine-born Lerena of
    Pablo Armando's own cohort, carrying a forename the Buenos Aires family used, and attached to neither.
  </p>
  <div class="note" style="margin-top:24px">
    <strong>He is not Pablo Armando's household</strong>, and Pablo Armando is not in the 1895 census at
    all, though he would have been thirteen. <strong>Nor is there a single Lerena recorded in Santa Fe or
    Rosario.</strong> The census Lerenas are Uruguayan in Buenos Aires, Spanish-born in another quarter of
    it, and scattered singles in Tucumán and Entre Ríos.
  </div>
</section>

<section class="blk">
  <h2 id="s-every-lerena-argentina-can-produce">Every Lerena Argentina can produce, drawn</h2>
  <p class="dek">Three documented Lerena households in nineteenth-century Argentina, and
    <strong>every one of them arrives from Uruguay.</strong> Then the fourth, which is the reason for the
    page.</p>
  <div class="grid two" style="margin-top:1.2rem;gap:24px">
    <div>
      <h3 style="margin:0 0 .4rem">The 1866 baptism at Rosario</h3>
      <p class="cap" style="margin:0 0 .6rem">The only Lerena in the index, 1731&ndash;1901</p>
      <Spine rows={rosario1866} u={u} />
    </div>
    <div>
      <h3 style="margin:0 0 .4rem">The Stud Book household</h3>
      <p class="cap" style="margin:0 0 .6rem">Buenos Aires, 1895 census</p>
      <Spine rows={gilbertoLine} u={u} />
    </div>
    <div>
      <h3 style="margin:0 0 .4rem">The family in the army drawer</h3>
      <p class="cap" style="margin:0 0 .6rem">Cajón 985 &mdash; Montevideo, Misiones, Buenos Aires</p>
      <Spine rows={alejandroLine} u={u} />
    </div>
    <div>
      <h3 style="margin:0 0 .4rem">And the one this archive is for</h3>
      <p class="cap" style="margin:0 0 .6rem">Rosario de Santa Fe &rarr; the Cape</p>
      <Spine rows={pabloLine} u={u} />
    </div>
  </div>
  <div class="panel" style="border-left:3px solid var(--terra);margin:24px 0">
    <div class="lab">What the four charts say together</div>
    <p style="margin:.6rem 0 0"><strong>Three of them point back across the river and say so on the
      record</strong> &mdash; <em>naturales del Estado Oriental</em>, born Uruguay 1854, born Uruguay
      1839. The Lerenas of Argentina are, so far as Argentina can show, <strong>Uruguayans who
      crossed</strong>.</p>
    <p style="margin:.6rem 0 0"><strong>The fourth points nowhere.</strong> Pablo Armando is documented in
      Argentina by a birthplace on his own passport and by nothing else: the Rosario baptism index holds
      no Lerena for 1881&ndash;83, the 1895 census holds no Lerena or Lerina household anywhere in Santa
      Fe province, and his parents exist on one card. <strong>He is the only one of the four whose
      Uruguayan origin is a hypothesis rather than a line of text.</strong>
      <a href={u("/uruguay/")}>The two Uruguayan houses &rarr;</a></p>
  </div>
</section>

<section class="blk">
  <h2 id="s-three-refusals-and-one-direction">Three refusals, and one direction</h2>
  <p>Three independent bodies of evidence have now declined to put this family at Rosario:</p>
  <div class="grid g3" style="margin-top:22px">
    <div class="panel"><span class="chip doc">Read</span>
      <p class="ab"><strong>Fourteen years of cathedral baptisms</strong>, 1882&ndash;1895, line by line —
        and until 1888 there was no other parish in the city.</p></div>
    <div class="panel"><span class="chip doc">Searched</span>
      <p class="ab"><strong>The whole FamilySearch index.</strong> Two records exist for him worldwide: a
        Cape marriage and a modern grave memorial.</p></div>
    <div class="panel"><span class="chip doc">Searched</span>
      <p class="ab"><strong>The 1895 national census.</strong> No Lerena in Santa Fe; none anywhere
        answering to him.</p></div>
  </div>
  <p style="margin-top:22px">
    Meanwhile <strong>Uruguay keeps answering</strong>: the world's densest Lerena population, a documented
    Montevideo kindred, and a household that crossed to Buenos Aires in the late 1880s.
    <a href={u("/hypotheses/")}>The hypotheses &rarr;</a>
  </p>
  <p class="cap" style="margin-top:16px">None of that unseats the passport. It is his own document, sworn
    at a consulate, naming a city, a province and a day. It does mean the corroboration has not been found
    where it ought to be — and that Argentine coverage online is thin enough for that to be a fact about
    the archives rather than about him.</p>
</section>

<section class="blk">
  <h2 id="s-where-to-go-next">Where to go next</h2>
  <p class="dek">Four routes, in the order they are worth trying. The first two are implied by the passport
    itself.</p>

  <h3 style="margin-top:26px">1 · His military enrolment — the strongest lead</h3>
  <p>The passport records a <em>libreta de enrolamiento</em> issued through the
    <strong>Consulado General Argentino</strong> at Cape Town, and gives his service as the
    <strong>Guardia Nacional, 6º de Caballería, 1915</strong>. Argentine military enrolment was made
    compulsory by <strong>Ley 4031 of 1901</strong>, and the <em>libreta</em> itself by
    <strong>Ley 8129 of 4 July 1911</strong>. A man born in 1882 belongs to the conscription
    <strong>clase 1882</strong>.</p>
  <p style="margin-top:12px"><strong>An enrolment record names the man's parents and his birthplace.</strong>
    Enrolment was done at the <em>Distrito Militar</em> of the declared domicile — so if he was at Rosario,
    Santa Fe's district holds it.</p>
  <ul>
    <li><strong>Archivo General del Ejército</strong>, Buenos Aires — takes reference enquiries by email.</li>
    <li><strong>FamilySearch has an agreement with the Argentine army archive</strong>; part of the
      collection is already online and should be searched before writing to anyone.</li>
    <li>The <em>Distritos Militares</em> registers are listed by province by the Centro de Estudios
      Genealógicos de San Luis.</li>
  </ul>

  <h3 style="margin-top:26px">2 · The consulate that issued the passport</h3>
  <p>To be issued an Argentine passport in 1940 he had to prove nationality — which means the
    <strong>Consulado General at Cape Town held a file on him</strong>: a <em>matrícula consular</em>,
    the registration every Argentine abroad made. Those files went home to the ministry.</p>
  <ul><li><strong>Archivo del Ministerio de Relaciones Exteriores y Culto</strong>, Buenos Aires.</li>
      <li>And on the South African side, the consulate's own correspondence in the
        <a href={u("/naairs/")}>national archives</a>.</li></ul>

  <h3 style="margin-top:26px">3 · Civil registration, which is not online</h3>
  <p>Argentine civil registration is <strong>provincial</strong>, and Santa Fe's is not indexed on
    FamilySearch for the 1880s at all — a control search for a common surname at Rosario in those years
    returns nothing. It has to be ordered directly.</p>
  <ul>
    <li><strong>Registro Civil de la Provincia de Santa Fe</strong> — births, marriages, deaths.</li>
    <li><strong>Archivo General de la Provincia de Santa Fe</strong>, and the Rosario municipal archive.</li>
  </ul>

  <h3 style="margin-top:26px">4 · Uruguay, which the evidence keeps indicating</h3>
  <p>Montevideo civil registration and parish registers, and the <strong>Lerena Lenguas</strong> kindred
    already surfacing there. If Rosario continues to refuse, this is not a fallback but the likelier
    answer. <a href={u("/name/")}>The name &rarr;</a></p>

  <div class="note" style="margin-top:26px"><strong>And one question of its own.</strong> This family named
    a son <strong>Gilberto Lerena</strong> in 1957, in South Africa, three generations after leaving. The
    stud-book Gilberto is now a documented man with a documented household. Either they were kin, or they
    knew exactly who he was — and both are worth finding out.</div>
</section>


<section class="blk">
  <h2 id="s-the-registers-now-searched-to-the-end">The registers, now searched to the end</h2>
  <p class="dek">Three years of baptisms under every surname; twenty-four years of marriages. Nothing.</p>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th>What</th><th>Covered</th><th>Result</th></tr></thead>
      <tbody>
        <tr><td><strong>Cathedral baptism index</strong> — every letter, any surname, looking for the given
          name <em>Pablo Armando</em></td><td class="m">1881 · 1882 · 1883</td>
          <td><strong>Not there.</strong> Twenty-six sections in each year; the cathedral was Rosario&rsquo;s
            only parish until 1888. Over twenty near misses logged and excluded — and only
            <strong>two Armandos</strong> in three whole years.</td></tr>
        <tr><td><strong>Marriage registers</strong>, Libro 9</td><td class="m">1884, act by act</td>
          <td>About two hundred marriages read with both parties and all four parents.
            <strong>One L-surname in the year</strong> — <em>Vicente Lavena × Angela Belmonte</em>, an
            Italian family. No Lerena.</td></tr>
        <tr><td><strong>Marriage registers</strong>, Libro 8</td><td class="m">1868–1884</td>
          <td>Answered from the search index, after a control proved the index covers those years.
            <strong>No Lerena marriage before 1900.</strong></td></tr>
      </tbody>
    </table>
  </div>
  <p class="cap" style="margin-top:16px">A practical note for anyone repeating this: these registers carry
    an <strong>Image Index panel</strong> that lists every act as text — both parties, their ages, and both
    sets of parents. The handwriting need not be read at all. It turns the series into a database.</p>
</section>

<section class="blk">
  <h2 id="s-the-surname-in-rosario-at-last-but-the-wrong-man-and-the-wro">The surname in Rosario, at last — but the wrong man and the wrong century</h2>
  <p class="prose">For a long time this archive could not find a single Lerena <em>in the city</em>, in any
    record, ever. Two searches have now changed that, and neither helps as much as it first appeared.</p>
  <div class="note" style="margin-top:18px"><strong>The 1869 national census.</strong>
    <em>Bartolomé <strong>Llerena</strong>, 45, married, Argentine, born in <strong>Córdoba</strong>, working
    as a <strong>jornalero</strong> — Rosario, Sección 2ª.</em> He is the <strong>only person of this
    surname found in Rosario before 1882</strong>, and he would be 58 the year Pablo Armando was born.
    <br><br><strong>But the schedule was opened and read, and it deflates the find.</strong> Every line
    carries its own number, and the twelve people on the page are of a dozen different surnames —
    washerwomen, a laundress, labourers, a peon, a carpenter, a Spanish shopkeeper. It is
    <strong>lodgings, not a household</strong>. No wife appears beside him though he is recorded married,
    and no children. And he is a <strong>day labourer</strong>, not a horseman or a man of property.</div>
  <p class="prose" style="margin-top:18px">The other two are twentieth century, at <strong>Santa Rosa de
    Lima</strong> — the parish that only opened in 1888: <strong>Luis Llerena</strong> and Clementina
    Baranda, whose son was baptised in <strong>1903</strong>; and <strong>Manuela Lerena</strong> and Diego
    Román, whose daughter <strong>Carmen</strong> was baptised in <strong>1918</strong>. Neither can be his
    parents. Both are on the <a href={u("/register/")}>register</a>.</p>
</section>

<section class="blk">
  <h2 id="s-which-rosario">Which Rosario?</h2>
  <div class="prose">
    <p><strong>Uruguay has its own Rosario</strong> — a town in the department of Colonia, on the River
      Plate. This archive nearly recorded a Uruguayan groom as a &ldquo;Rosario-born Llerena&rdquo; linking
      the two countries, until his record was opened and every other person on it turned out to be
      Uruguayan: Solís Grande, Maldonado, Punta de Carretas, Cordón.</p>
    <p>Given how much of this family&rsquo;s evidence runs through Uruguay, that ambiguity deserves saying
      out loud. <strong>If any part of the family&rsquo;s memory of &ldquo;Rosario&rdquo; came down through
      a Uruguayan branch, the town could be the wrong one</strong> — and years of work in Santa Fe would
      have been done in the wrong country.</p>
    <p><span class="chip inf">Recorded, and weak</span> <strong>The passport is against it.</strong> His own
      1940 document says <em>&ldquo;Rosario de Santa Fe&rdquo;</em> — naming the province, not merely the
      town. It would take a great deal more than an ambiguity to overturn that.</p>
  </div>
</section>

<section class="blk">
  <h2 id="s-three-routes">The last three routes, walked</h2>
  <div class="prose">
    <p>After the 1882 register walk and the test of the father's name, three routes were named as the
    only ones still live. All three were walked on 17 September 2026. <strong>None of them finds his
    parents</strong>, and that is written down here so the next person does not spend the same day
    finding out.</p>
    <p>One of the three <strong>should not have been offered at all</strong>: in February 1882 Rosario
    had only one parish, so there are no "other parishes" to search. That is logged as a correction
    against this archive rather than quietly dropped.</p>
  </div>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr>
        <th style="width:14rem">Route</th><th style="width:16rem">What was done</th>
        <th style="width:20rem">What came back</th><th>Verdict</th>
      </tr></thead>
      <tbody>
        {routes.map((r) => { const c = Object.values(r); return (
          <tr>
            <th set:html={emph(c[0])} />
            <td class="cap" set:html={emph(c[1])} />
            <td class="cap" set:html={emph(c[2])} />
            <td class="cap" set:html={emph(c[3])} />
          </tr>); })}
      </tbody>
    </table>
  </div>
</section>

<section class="blk">
  <h2 id="s-letter">The letter to the Registro Civil, and why the ask changed</h2>
  <div class="prose">
    <p>The four results above all point off this site, to the provincial registry. Drafting the
    request changed it, though: <strong>civil registration in Santa Fe begins in 1886</strong>, four
    years after he was born, so <strong>the 1882 birth act this archive was about to ask for cannot
    exist</strong>. Asking would have spent the letter on a certainty.</p>
    <p>So the letter asks for the three things that could exist &mdash; and
    <strong>the strongest of them is not about him at all</strong>.</p>
  </div>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th style="width:15rem">Part</th><th>Text</th></tr></thead>
      <tbody>
