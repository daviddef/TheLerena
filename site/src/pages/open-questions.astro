---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import Questions from "@daviddef/archive-kit/components/Questions.astro";
import qs from "../data/open-questions.json";

/* THE QUESTIONS ARE ROWS NOW, not prose - extracted 7 October 2026 into
   data/open-questions.tsv. The kit's Questions component says in its own
   docstring that five of seven archives keep their questions as prose and
   "cannot use this until somebody extracts them, and that extraction is
   research work belonging to each archive rather than something to guess at
   from outside". This is that extraction, done from inside.

   WHAT HAD TO SURVIVE IT: the long panel under question 1 - the Lerena-Lerena
   compound test, the forty-three transcription doublings, the Carmen Lerena
   act read off the plate, and the line that says the test lowers the
   probability without settling it. All of it is in that row's `tried`. A
   refactor that loses a question's negative evidence is worse than the prose
   it replaced. */
const rows = qs.filter((r) => r.q);
---
<Base title="Open Questions"
      eyebrow="Published so strangers can help"
      dek="Published deliberately. An archive that lists only its answers is advertising; one that lists its questions can be helped by strangers.">

<section class="blk">
  <div class="prose">
    <p><strong>Seven questions and two closed doors.</strong> Each carries what is known, what has
      already been tried, and &mdash; the part that makes this a work queue rather than a list of
      regrets &mdash; <strong>the specific record that would answer it</strong>.</p>
    <p class="cap">The two marked <em>blocked</em> are not questions about the family. They are routes
      that failed, kept so nobody walks them again.</p>
  </div>
  <Questions rows={rows} u={u} unit="questions" />
</section>

</Base>
