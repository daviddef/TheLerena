---
import lastAlive from "../data/sancho-last-alive.json";
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { emph } from "../lib/text.js";
import ramon from "../data/ramon-lerena-rosario.json";
import mauricio from "../data/mauricio-casimira-montano.json";
import alejandros from "../data/the-three-alejandros.json";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import spines from "../data/descent-spines.json";
import trinidad from "../data/trinidad-flores-sweep-2026-09-27.json";

/* The two descents drawn the same way, so the eye can do the comparing. Both
   start in Spain, both cross, both spread across the Banda Oriental — and they
   never touch. Generation 1 of each is the Spanish couple named on a River
   Plate act; neither has been found in a Spanish register yet, so both are
   marked as the joint that cannot bear weight. */
const spine = (house) => spines
  .filter((r) => r.house === house)
  .map((r) => Object.fromEntries(
    Object.entries(r)
      .filter(([k, v]) => !["house", "register"].includes(k) && v !== "" && v !== "-")
      .map(([k, v]) => [k, k === "weak" ? v === "yes" : v])));

const sanchoHouse = spine("sancho");
const ramonHouse = spine("ramon");
const argentineLine = spine("argentine");
const ramonRows = ramon.filter((r) => r.generation && r.grade && r.grade !== "grade");
const mauricioRows = mauricio.filter((r) => r.child && r.grade && r.grade !== "grade");
import dUruguayFourDepartments from "../data/uruguay-four-departments.json";
import d1812UnionAct from "../data/1812-union-act.json";
import fs20 from "../data/fs-session-2026-09-20.json";
import gl from "../data/gonzalez-lerena.json";
import colla from "../data/rosario-colla-household.json";
import h97 from "../data/household-97-serena.json";
import h229 from "../data/household-229-pedro-antonio.json";
import sweep from "../data/census-seven-spellings.json";
import dom from "../data/dominga-carballo-1836.json";
import carts from "../data/luis-llerena-carts.json";
import maria from "../data/maria-llerena-casa-2.json";
import filmmap from "../data/film-7499043-map.json";
import sanjose from "../data/alberto-lerena-larriera.json";
import disp from "../data/montevideo-dispensations-fulltext.json";
import zact from "../data/zelmira-cordero-1904-act.json";
import cons from "../data/trinidad-consanguinity-explained.json";
import ans from "../data/dispensations-answered-1894-1913.json";
import kindred from "../data/trinidad-founding-kindred.json";
import bridge from "../data/colla-trinidad-bridge.json";
import fouracts from "../data/lerena-pelaez-four-acts.json";
import zald from "../data/zalduondo-two-plates.json";
---
<Base title="Uruguay"
      eyebrow="Two Lerena families, two Spanish origins, and neither of them is his"
      dek="There are two documented Lerena families in nineteenth-century Uruguay, and on 17 September 2026 a baptism act of 1812 settled what they are to each other: nothing. One came from Córdoba in Andalusia, the other from Valdemoro outside Madrid. The surname entered the Banda Oriental twice, from opposite ends of Spain.">

<section class="blk">
  <h2 id="s-consanguinity">Why the Trinidad Lerenas needed dispensing</h2>
  <p class="dek">9 October 2026. One birth act answers it, because it names all four grandparents.</p>
  <div class="prose">
    <p><strong>A Uruguayan civil birth act names both parents and all four grandparents</strong>
      &mdash; with ages, trades and addresses. That is why a single entry of 1897 does more than the
      nine dispensations put together. <strong>Flores, Birth Records 1887&ndash;1901, No. 10:</strong>
      Cayetano Alberto Fern&aacute;ndez, born at <strong>Pintos</strong> on 7 August 1897.</p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {cons.filter((r) => r["who the act names"]).map((r) => (
      <div><dt set:html={emph(r["who the act names"])} /><dd>
        <span set:html={emph(r["as it gives them"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>The shape of it.</strong> The groom of 1885 descends from a Lerena through his mother
      <strong>Socorro</strong>; the bride descends from a Lerena through her father
      <strong>Bernab&eacute;</strong>. <strong>Lerena blood runs down both sides of that marriage</strong>,
      which is what the Archbishop was dispensing. If Socorro and Bernab&eacute; are brother and
      sister the couple are first cousins &mdash; exactly what an equal second degree means &mdash;
      but <strong>Socorro&rsquo;s own parents are not named, so that link is inferred and not
      proved</strong>.</p>
    <p><strong>And it reaches back further than 1885.</strong> At Trinidad on 6 March 1880,
      <strong>Mar&iacute;a Pel&aacute;ez, thirty, daughter of Juan Pel&aacute;ez and Antonina
      Lerena</strong>, married a widower &mdash; her mother witnessing. A daughter of thirty puts
      <em>that</em> Antonina&rsquo;s birth near 1830. <strong>So a Lerena married a Pel&aacute;ez
      around 1845</strong>, and Bernab&eacute; Lerena married another Pel&aacute;ez a generation
      later. By the third generation the Church had to compute the degrees &mdash; which is the whole
      explanation of 1885, 1894 and 1913. <strong>That was written as a prediction on 9 October,
      before either of the two acts below had been opened.</strong>
      <a href="#s-answered">The 1894 and 1913 couples &rarr;</a></p>
    <p class="cap"><strong>And there are two Antonina Lerenas at Trinidad.</strong> The elder, born
      about 1830, who married Juan Pel&aacute;ez; and the younger, born about 1862, daughter of
      Bernab&eacute; and Casimira, who married Serapio Fern&aacute;ndez. <strong>Two women of one
      name in one small town</strong>, and this archive came close to holding one.</p>
  </div>
</section>

<section class="blk">
  <h2 id="s-four-acts">Four acts from one compound search, and the diagram confirmed</h2>
  <p class="dek">10 October 2026. &ldquo;Lerena Pel&aacute;ez&rdquo; &mdash; four documents in the whole corpus, every one opened.</p>
  <div class="prose">
    <p><strong>The search was aimed somewhere else.</strong> The work list asked for the
      compound-surname technique to be crossed with the <em>dispensation</em> series. It found no
      dispensations at all. <strong>It found four acts that name three generations of the Trinidad
      kindred</strong> &mdash; and one of them confirms the apex of the 1858 kinship diagram from a
      completely separate record system.</p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {fouracts.filter((r) => r["the act"]).map((r) => (
      <div><dt set:html={emph(r["the act"])} /><dd>
        <span set:html={emph(r["what it says"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>A priest drew it and a Juez de Paz wrote it.</strong> In 1858 the Cura Vicario of
      Trinidad sketched <strong>Ram&oacute;n Lerena and Mar&iacute;a Gonz&aacute;lez</strong> over
      Alejandro and Antonina to prove an impediment. In 1911, fifty-three years later and in the civil
      register, Antonina&rsquo;s own death act calls her <em>&ldquo;hija leg&iacute;tima de Don
      Ram&oacute;n Lerena y de Do&ntilde;a Mar&iacute;a Gonz&aacute;lez&rdquo;</em>.
      <strong>Two independent documents, one couple.</strong></p>
    <p class="cap"><strong>And it cost an inference.</strong> This register had her born about 1830,
      reasoned from a daughter aged thirty in 1880. The act states <strong>ninety-two</strong> &mdash;
      so about <strong>1819</strong>, eleven years earlier &mdash; and gives her birthplace as
      <strong>Montevideo</strong> where the 1858 expediente says San Jos&eacute;.
      <a href={u("/corrections/")}>Corrections &rarr;</a></p>
  </div>
</section>

<section class="blk">
  <h2 id="s-zalduondo">Two plates, ten years apart &mdash; and we were wrong about both</h2>
  <p class="dek">11 October 2026. A surname this archive carried for three weeks was never on either document.</p>
  <div class="prose">
    <p><strong>This section replaces one published four hours earlier that argued the opposite
      case.</strong> The argument is kept below rather than quietly deleted, because the way it
      failed is worth more than the fact it got wrong.</p>
    <p><strong>What the morning believed.</strong> A civil index gave Ang&eacute;lica Mar&iacute;a
      Lerena Villademoros a husband, <em>Eduardo Zalduando Pou</em>, with his parents and children.
      All of those people were already in this register under <strong>Zalsamendi</strong>, entered
      three weeks earlier from the plate of a Pocitos baptism of 1903. So the reasoning ran: a plate
      outranks an index, therefore <em>Zalsamendi</em> is right and the index is mangling the name.
      That was published.</p>
    <p><strong>Then the plates were read.</strong> The 1903 entry is <em>headed</em>
      &ldquo;Mar&iacute;a Zalduondo&rdquo;; its father is <strong>Eduardo Zalduondo</strong>; its
      paternal grandmother is <strong>Dolores Pou de Zalduondo</strong>. The 1913 death act says
      <em>&ldquo;ha fallecido Eduardo Zalduando &hellip; era hijo de Juan Zalduondo y de Dolores Pou,
      fallecidos&rdquo;</em>. <strong>Zalsamendi is on neither plate.</strong></p>
  </div>
  <div class="panel" style="margin-top:18px">
    <p style="margin:0"><strong>The error in the argument, which is the part worth keeping.</strong>
      &ldquo;A plate outranks an index&rdquo; is true. But this session was not holding a plate &mdash;
      it was holding <strong>another session&rsquo;s reading of a plate</strong>, and it treated the
      two as the same thing. The index was the only party in the room that had actually been right.</p>
    <p style="margin:12px 0 0">There was even a tell in plain view, and it was read backwards. This
      archive&rsquo;s own note recorded that a <em>machine</em> transcript of the same act had produced
      &ldquo;Del Suando&rdquo;. <strong>Two readers failing on one hand is evidence the hand is
      hard</strong> &mdash; it was used instead as evidence that machines and indexes are careless.
      A second tell was ignored outright: the index called the child Mar&iacute;a Margarita
      <strong>Luisa</strong>, a fourth name the 1903 reading had dropped. The plate has it.</p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {zald.filter((r) => r["which record"]).map((r) => (
      <div><dt set:html={emph(r["which record"])} /><dd>
        <span set:html={emph(r["what it says, from the image"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>One child cannot be inside two different unions.</strong> The 1903 baptism makes
      Mar&iacute;a Margarita the daughter of <strong>Amelia</strong> Lerena; the 1913 death act makes
      her one of three children of the union with <strong>Ang&eacute;lica</strong> Lerena. That is
      what forces them to be <strong>one woman</strong> rather than two sisters, and the two rows
      this archive held separately are now merged.</p>
    <p><strong>The forename is not explained, only outvoted.</strong> Her 1872 baptism says
      Ang&eacute;lica Mar&iacute;a and the 1913 act says Ang&eacute;lica; only the 1903 priest wrote
      Amelia, and he wrote it clearly &mdash; it was checked at high magnification precisely because
      it was inconvenient. <strong>Two to one is not an explanation.</strong> &ldquo;Amelia&rdquo; is
      kept as a recorded variant rather than erased, so that a reader who meets her under that name
      in the Pocitos register can still find her here.</p>
    <p class="cap"><strong>What the two plates added along the way:</strong> he was born at
      <strong>Montevideo</strong> about 1861, was <strong>retired on a pension at fifty-two</strong>,
      died of <strong>angina de pecho</strong> at calle Juan B. Blanco 9, and both his parents were
      already dead. A third child, <strong>Mar&iacute;a Elena</strong>, is new.
      <a href={u("/corrections/")}>Corrections &rarr;</a></p>
    <p class="cap"><strong>Her own marriage act is still not found</strong>, which is why the work-list
      row stays open. Everything here comes from a baptism and a death.</p>
  </div>
</section>

<section class="blk">
  <h2 id="s-bridge">The bridge to Colla, and what reading the plate cost</h2>
  <p class="dek">9 October 2026. A test named in the morning, run in the afternoon, and failed by the claim that set it.</p>
  <div class="prose">
    <p><strong>The obvious move was a merge, and it was refused.</strong> The Trinidad expedientes
      gave the kindred a head &mdash; <strong>Ram&oacute;n Lerena and Mar&iacute;a Gonz&aacute;lez</strong>
      &mdash; and this register already held a Ram&oacute;n Lerena of Rosario-Colla married to a
      Mar&iacute;a Josefa Gonz&aacute;lez. The stated weakness was that the 1837 act behind that row
      was <em>indexed, not image-read</em>. <strong>So it was read.</strong></p>
    <p><strong>It corrected the argument instead of confirming it.</strong> The act says Mauricio was
      born at <em>la Villa del Colla</em>; the expediente says the Trinidad Lerenas are
      <em>naturales de San Jos&eacute;</em>. Different birthplaces. The &ldquo;shared origin&rdquo;
      published that morning is withdrawn &mdash; and the index had said <em>Birthplace: Colla</em>
      all along, on the very page being cited.
      <a href={u("/corrections/")}>Corrections &rarr;</a></p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {bridge.filter((r) => r["the step"]).map((r) => (
      <div><dt set:html={emph(r["the step"])} /><dd>
        <span set:html={emph(r["what was found"])} /><br />
        <span class="cap" set:html={emph(r["what it does to the argument"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>What replaced it is better evidence of a worse-behaved kind.</strong> A Flores birth
      act of 1895 has <strong>Cipriano Lerena of Trinidad</strong> name his wife and both his parents
      in one sentence &mdash; <strong>Mauricio and Casimira Montaño</strong>. So one of the Trinidad
      men is a <em>grandson</em> of a Ram&oacute;n Lerena and Mar&iacute;a Gonz&aacute;lez by the
      1837 act, and Bernab&eacute; is a grandson of a Ram&oacute;n Lerena and Mar&iacute;a
      Gonz&aacute;lez by the 1858 diagram. <strong>Two routes, no shared document, same two
      names.</strong></p>
    <p><strong>And then the test was run, and it returned this archive&rsquo;s own answer.</strong>
      Searching the index for &ldquo;any record naming Ram&oacute;n with more than one child&rdquo;
      produced <strong>Alejandro&rsquo;s marriage of 16 September 1825</strong> &mdash; and, on
      reading the plate: <em>&ldquo;Alexandro Lere&ntilde;a, natural de la Villa del Rosario, hijo
      leg&iacute;timo de Ram&oacute;n Lere&ntilde;a y de Mar&iacute;a Josefa
      Gonz&aacute;lez&rdquo;</em>. The full <em>Josefa</em>, in a priest&rsquo;s hand.
      <strong>Ram&oacute;n of Rosario-Colla is Ram&oacute;n of the Trinidad diagram.</strong></p>
    <p><strong>The refusal to merge was wrong, and it was wrong about the archive rather than the
      family.</strong> These pages had carried the identification since 17 September. What 9 October
      actually added was not the conclusion but its <em>grade</em> &mdash; index-level then,
      plate-level now, with Socorro&rsquo;s parentage and a priest&rsquo;s diagram besides.</p>
    <p><strong>It also turned an inference into a document.</strong> The 1825 act gives
      Margarita&rsquo;s parents as <strong>Juan Fern&aacute;ndez &Aacute;lvarez and B&aacute;rbara
      Sotura</strong> &mdash; and the 1855 expediente gives Serapio Fern&aacute;ndez&rsquo;s
      grandparents as <em>&ldquo;Don Juan y Do&ntilde;a B&aacute;rbara Sotura&rdquo;</em>. Same
      parents, so <strong>Margarita and Manuel are brother and sister</strong>, which is exactly the
      second grade dispensed in 1855. That sibship was published this morning as &ldquo;required by
      the degree and not written down in either act&rdquo;. <strong>A third act wrote it
      down.</strong></p>
    <p class="cap"><strong>And a warning kept beside the fact.</strong> Casimira Montaño buried a
      seven-day-old daughter, <strong>Abdona Ignacia</strong>, in 1850. The register lists an
      <em>Ignacia Lerena</em> marrying at Trinidad in 1882 as a candidate child of the same couple.
      Reusing a dead infant&rsquo;s name was ordinary &mdash; <strong>which is exactly how two people
      become one by accident</strong>.</p>
  </div>
</section>

<section class="blk">
  <h2 id="s-kindred">The head of the Trinidad kindred, drawn by the priest who married them</h2>
  <p class="dek">9 October 2026. Three marriage expedientes of the 1850s, and a question closed.</p>
  <div class="prose">
    <p><strong>This archive published, twice, that these records could not do this.</strong> First
      that the Montevideo dispensations name a groom&rsquo;s parents &mdash; corrected, because the
      volumes of 1885&ndash;1913 are a one-sentence summary ledger. Then that the
      <em>informaciones matrimoniales</em> were a separate series it had not reached.
      <strong>Both volumes live in the same collection.</strong> The difference is the decade: the
      1850s books are <strong>full expedientes</strong> &mdash; petition, interrogatory, sworn
      depositions naming four generations. <a href={u("/corrections/")}>Corrections &rarr;</a></p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {kindred.filter((r) => r["the document"]).map((r) => (
      <div><dt set:html={emph(r["the document"])} /><dd>
        <span set:html={emph(r["what it says"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>What the Cura Vicario drew.</strong> On the folio of Bernab&eacute; Lerena&rsquo;s
      expediente, 15 February 1858, boxed in his own hand:</p>
  </div>
  <pre class="fig" aria-label="Kinship diagram drawn by the Cura Vicario, 15 February 1858"
       style="margin-top:12px; overflow-x:auto; line-height:1.5">{`        Ramon Lerena  ──  Maria Gonzalez
                 │
        ┌────────┴────────┐
  Alejandro Lerena    Antonina Lerena
  Margarita Fernandez Juan Pelaes
        │                 │
  Bernabé Lerena      Casimira Pelaez
   "contrayente"      "la contrayente"`}</pre>
  <div class="prose" style="margin-top:18px">
    <p><strong>Which answers the question this archive had left standing.</strong> The 1855
      expediente makes <strong>Socorro Lerena</strong> a daughter of Alejandro and Margarita; the
      1858 one makes <strong>Bernab&eacute; Lerena</strong> a son of the same couple.
      <strong>They are brother and sister</strong> &mdash; so the dispensation of 26 June 1885 is
      explained: Serapio Fern&aacute;ndez the younger descends from Socorro, Antonina Lerena from
      Bernab&eacute;, and they are first cousins, which is exactly the second grade in the equal
      lateral line. <strong>It was an inference for a day and it is a document now.</strong></p>
    <p><strong>And the surname is mangled five ways on one page.</strong> The transcript of that
      diagram reads <em>Ram&oacute;n <strong>Serena</strong></em>, <em>Alejandro
      <strong>Lorena</strong></em>, <em>Antonina <strong>Lorena</strong></em>, <em>Bernab&eacute;
      <strong>Leresa</strong></em> &mdash; and, four lines above in prose, <em>Antonina
      <strong>Lerena</strong></em>, correctly. <strong>The plate shows all five are the same word in
      the same hand.</strong> <a href={u("/name/")}>The name &rarr;</a></p>
    <p class="cap"><strong>And the thing this section called &ldquo;deliberately not
      concluded&rdquo; was concluded three weeks ago, in this archive&rsquo;s own files.</strong>
      <code>data/ramon-lerena-rosario.tsv</code> has said since 17 September that Bernab&eacute; is
      Alejandro&rsquo;s son, Cipriano is Mauricio&rsquo;s, and Alejandro and Mauricio are brothers
      &mdash; and the spine below has drawn it. <strong>The caution published here was not caution,
      it was not having read the archive.</strong> Alejandro&rsquo;s own marriage act of 16
      September 1825 has since settled it on the plate as well.
      <a href={u("/corrections/")}>Corrections &rarr;</a></p>
  </div>
</section>

<section class="blk">
  <h2 id="s-answered">The 1894 and 1913 couples, answered by their children</h2>
  <p class="dek">9 October 2026. Search the bride, then look for a child &mdash; not for a marriage.</p>
  <div class="prose">
    <p><strong>The dispensation ledger will never name a parent.</strong> It is the Vicar
      General&rsquo;s summary, one sentence per couple. So these two were answered sideways:
      <strong>find a child, and read the child&rsquo;s record</strong>. A Uruguayan civil birth act
      names all four grandparents with ages, trades and addresses; a Trinidad baptism act of this
      period names both pairs of grandparents in one line. Either way,
      <strong>the child&rsquo;s record names the couple&rsquo;s parents</strong>.</p>
    <p class="cap">Both acts were found by full-text search and then <strong>read off the
      plate</strong>, because the machine transcript misspelled the surname in both of them.</p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {ans.filter((r) => r["the act"]).map((r) => (
      <div><dt set:html={emph(r["the act"])} /><dd>
        <span set:html={emph(r["what it says"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>What 1913 settles.</strong> Vitalino Gregorio Pel&aacute;ez&rsquo;s mother was
      <strong>Mar&iacute;a Lerena</strong>, dispensed in 1885 to marry his father; Florinda Juana
      Lerena&rsquo;s father was <strong>Bernab&eacute; Lerena</strong>, the man of the 1911 kinship
      diagram. <strong>So the bride of 1913 is a sister of Custodio Lerena</strong> &mdash; and two
      full-text finds made three weeks apart turn out to be one family.</p>
    <p><strong>And the degree does something a one-line ledger entry has no business doing: it rules
      an identification out.</strong> Bernab&eacute;&rsquo;s own sister was <em>also</em> a
      Mar&iacute;a Lerena, who married Eliseo Cardozo. Were she Vitalino&rsquo;s mother, the couple
      would be first cousins and the impediment the <em>second</em> degree. The clerk wrote the
      <strong>third</strong>. <strong>There are two Mar&iacute;a Lerenas, and the Church&rsquo;s
      arithmetic proves it.</strong></p>
    <p><strong>What 1894 settles, and what it costs.</strong> The 1905 baptism names Juan
      Lerena&rsquo;s parents as <strong>Bernab&eacute; and Casimira Pel&aacute;ez</strong> &mdash; so
      he is <strong>a sixth child of the Trinidad founding couple</strong>, and he is the man this
      register had been carrying as a <em>separate person</em> since that morning. <strong>The split
      is retracted.</strong> It was not bad reasoning; the evidence arrived a day late.
      <a href={u("/corrections/")}>Corrections &rarr;</a></p>
    <p class="cap"><strong>One impediment is still unexplained.</strong> 1894 was dispensed in the
      second degree <em>and</em> the third, accumulated &mdash; two separate blood paths. His mother
      a Pel&aacute;ez and her father a Pel&aacute;ez accounts for the second.
      <strong>The second tie has not been found, and is not guessed at here.</strong></p>
  </div>
</section>

<section class="blk">
  <h2 id="s-zelmira-act">The act behind one of them</h2>
  <p class="dek">9 October 2026. What the ledger could not give.</p>
  <div class="prose">
    <p><strong>The dispensation register names a couple and an impediment and no parent.</strong> The
      <em>act</em> names four parents, two ages, two nationalities, a profession, an address and a
      church. This one is headed, in the register&rsquo;s own hand,
      <strong>&ldquo;Matrimonio de Cordero y Lorena&rdquo;</strong>.</p>
  </div>
  <dl class="kv" style="margin-top:18px">
    {zact.filter((r) => r.field).map((r) => (
      <div><dt set:html={emph(r.field)} /><dd>
        <span set:html={emph(r["what the act says"])} /><br />
        <span class="cap" set:html={emph(r["what it settles"])} />
      </dd></div>
    ))}
  </dl>
  <div class="prose" style="margin-top:18px">
    <p><strong>She was a woman this archive wrote off.</strong> On 14 September
      <strong>Zelmira Carlota Lerena Larriera</strong> was tested and set aside as
      &ldquo;not ours&rdquo;; that verdict was itself corrected. <strong>Here she is on an act of her
      own</strong>, with her parents named in a register rather than an index, and married to a man
      the Archbishop had to dispense because he was her blood relative.</p>
    <p><strong>And the act writes her surname twice, two ways.</strong> Her father is
      <em>&ldquo;D. Alberto <strong>Serena</strong>&rdquo;</em>; her mother, witnessing four lines
      later, is <em>&ldquo;Do&ntilde;a Mar&iacute;a In&eacute;s Larriera de <strong>Lerena</strong>&rdquo;</em>.
      They are husband and wife. <strong>It is the cleanest demonstration of the S-for-L trap this
      archive has collected</strong>, because no other explanation is available.
      <a href={u("/name/")}>The name &rarr;</a></p>
  </div>
</section>

<section class="blk">
  <h2 id="s-dispensations">Nine dispensations, and the degree of kinship in each</h2>
  <p class="dek">9 October 2026. Read by full text, which goes round the index.</p>
  <div class="prose">
    <p><strong>This archive came here for the wrong reason and found a better one.</strong> The
      work-list said dispensations were worth opening because a pre-marriage investigation
      &ldquo;routinely gives a Spanish groom&rsquo;s parents&rdquo;. <strong>That is true of the
      <em>expediente</em> and not of this book.</strong> The <em>Arquidi&oacute;cesis de Montevideo
      Marriage Dispensation Records</em> are the Vicar General&rsquo;s summary ledger &mdash; one
      sentence per couple &mdash; and <strong>not one of these nine entries names a parent</strong>.
      Two record classes were conflated.</p>
    <p><strong>What the ledger gives instead answers a question this archive has had for longer.</strong>
      A <strong>consanguinity</strong> dispensation is a statement about <em>shared ancestry</em>:
      the Church computed the degree before it would dispense. <strong>A second degree in the equal
      lateral line is first cousins; a third degree is second cousins; &ldquo;with attingency to the
      second&rdquo; means two separate blood paths at once.</strong> That constrains a pedigree even
      where no parent is written down.</p>
  </div>
  <table class="tbl" style="margin-top:18px">
    <thead><tr><th>Dated</th><th>Who</th><th>The impediment</th></tr></thead>
    <tbody>
      {disp.filter((r) => r.date).map((r) => (
        <tr>
          <td set:html={emph(r.date)} />
          <td set:html={emph(r.who)} />
          <td set:html={emph(r["the impediment, as the register states it"])} />
        </tr>
      ))}
    </tbody>
  </table>
  <div class="prose" style="margin-top:18px">
    <p><strong>The Lerenas of Trinidad married P&eacute;laez, and kept marrying them.</strong> Four
      unions in this list or already in this archive &mdash; Bernab&eacute; Lerena and Casimira
      Pel&aacute;ez; M&aacute;ximo Pel&aacute;ez and Mar&iacute;a Lerena, 1885; Juan Lerena and
      Eduviges Pel&aacute;ez, 1894; Vitalino Gregorio Pel&aacute;ez and Florinda Juana Lerena, 1913.
      <strong>Two of them needed dispensing because the couple were already cousins</strong>, and
      Juan Lerena needed dispensing twice over, in the second degree <em>and</em> the third.</p>
    <p><strong>And two Lerena women of Trinidad were dispensed in a single sitting on 26 June
      1885</strong> &mdash; Antonina to a <strong>Fern&aacute;ndez</strong>, Mar&iacute;a to a
      <strong>Pel&aacute;ez</strong>. Fern&aacute;ndez is the surname of Sancho Llerena&rsquo;s wife
      and of Avelino Lerena Fern&aacute;ndez. <strong>This is a kindred marrying inside itself, and
      the Church wrote down how closely.</strong></p>
  </div>
</section>

<section class="blk">
  <div class="panel" style="margin:1.4rem 0">
    <p style="margin:0">
      <strong>Why this page exists.</strong> The surname is rare, so it was natural to assume the
      Uruguayan Lerenas were one kindred. <strong>They are two</strong>, and both are documented from
      parish and civil registers rather than from anybody&rsquo;s tree. Keeping them apart is not
      pedantry: it is the difference between a family tree and a wish.
      <a href={u("/argentina/")}>Argentina &rarr;</a> &middot;
      <a href={u("/direct-line/")}>The Spine &rarr;</a>
    </p>
  </div>
</section>

<section class="blk">
  <h2>The two houses</h2>
  <div class="grid two" style="margin-top:1rem">
    <div class="card">
      <h3>Sancho&rsquo;s house &mdash; Canelones, then Montevideo</h3>
      <p><strong>SANCHO LLERENA</strong> married <strong>María Fernández</strong> at Canelones on
        <strong>8 January 1791</strong>. The act calls him <em>natural de Córdova la Llana</em> and names
        his parents, <strong>Félix Llerena and Rosalía Aguilar</strong>. A dragoon; in 1798 he swore an
        oath and could not sign his name.</p>
      <p>Eight children between 1793 and 1815, and out of them the <strong>Montevideo trunk</strong> —
        the <em>Lerena Lenguas</em> and the <em>Lerena Traibel</em>. His son <strong>Avelino</strong>
        (1815&ndash;1890) married <strong>Ambrosia Traibel y Centeno</strong> and fathered the second of
        those branches.</p>
    </div>
    <div class="card">
      <h3>Ramón&rsquo;s house &mdash; Rosario, then the interior</h3>
      <p><strong>RAMÓN SERENA</strong> — so the act writes him; the indexes say Lerena and Gerena —
        <em>natural de <strong>Valdemoro en Castilla la Nueva</strong></em>, married
        <strong>María Josefa González</strong>, <em>natural de la Ysla de Canarias, <strong>Lanzarote</strong></em>.
        He was fathering children from about 1800, and his sons were born in Uruguay: Alejandro at
        <strong>Rosario</strong>, Mauricio at <strong>Colla</strong> — the Rosario district of
        <strong>Colonia</strong>.</p>
      <p>His own parents are <strong>Salvador Serena and Ana de Cubas</strong>, which is where the current
        tree&rsquo;s otherwise unexplained &ldquo;Ramón Llerena <em>Cubas</em>&rdquo; comes from. From his
        sons come the <strong>Trinidad kindred</strong> of Flores and a spread across San José, Florida,
        Salto and Montevideo.</p>
    </div>
  </div>
</section>

<section class="blk">
  <h2>They are not one family, and an act of 1812 says so in five words</h2>
  <div class="prose">
    <p>This was the question worth asking, because if the two houses were one the Uruguayan picture would
      close. <strong>They are not, and the answer did not come from arithmetic in the end. It came from a
      sentence.</strong></p>
    <p>On <strong>15 November 1812</strong>, at the <strong>Iglesia Matriz of Montevideo</strong>, Don Juan
      Lloberas baptised <strong>Manuel Lorenzo</strong>, born the day before, and wrote down where the
      parents came from:</p>
    <blockquote style="margin:1rem 0;padding-left:1rem;border-left:3px solid var(--rule,#d8d2c6)">
      <p style="margin:0"><em>&hellip;hijo legítimo de <strong>RAMON SERENA natural de VALDEMORO en
        CASTILLA LA NUEVA</strong>, y de <strong>María Josefa González natural de la Ysla de Canarias,
        LANZAROTE</strong>. Abuelos paternos <strong>Salvador Serena y Ana de Cubas</strong>; id. maternos
        <strong>Marcial de León González è Ysavel Lorenza</strong>.</em></p>
    </blockquote>
    <p><strong>Valdemoro is twenty-seven kilometres south of Madrid. Sancho was <em>natural de Córdova la
      Llana</em>, in Andalusia, five hundred kilometres away.</strong> Two separate Spanish emigrations,
      two separate arrivals, one rare surname. <a href={u("/searched/")}>Read the act &rarr;</a></p>
    <p>The arithmetic had already said they could not be father and son — Alejandro married in 1825 so
      Ramón was born about 1775&ndash;85, while Sancho married in 1791 and had his first child in 1793 —
      and their fathers were different men, <strong>Félix</strong> and <strong>Salvador</strong>. The act
      closes what the arithmetic left open.</p>
  </div>
  <div class="panel" style="border-left:3px solid var(--ochre,#8a7f5c);margin:1.4rem 0">
    <div class="lab">A coincidence, correctly distrusted, and now discharged</div>
    <p style="margin:.6rem 0 0">Before the act was read, this page recorded that Sancho&rsquo;s father is
      written <strong><em>Feliz GERENA</em></strong> on a Montevideo act of <strong>1811</strong> and
      Ramón&rsquo;s father <strong><em>Salvador GERENA</em></strong> on one of <strong>1812</strong> — and
      called it <em>&ldquo;a scribal habit of one place and one time rather than two families
      independently choosing the same variant&rdquo;</em>, a reason to look and not a reason to believe.</p>
    <p style="margin:.6rem 0 0"><strong>That was exactly right.</strong> The act itself writes
      <strong>SERENA</strong>, and both men were baptising children <strong>at the same font, one year
      apart</strong>. Two families of the same rare surname, in one small city, at one church — and from
      opposite ends of Spain. <strong>The resemblance was real and it meant nothing.</strong></p>
  </div>
</section>

<section class="blk">
  <h2>The two descents, drawn</h2>
  <p class="dek">The same four generations of each, side by side. <strong>Both begin with a Spanish
    couple named on a River Plate act and found in no Spanish register yet</strong> — so generation one
    of each is marked as the joint that cannot bear weight. Both cross the Atlantic, both spread across
    the Banda Oriental, <strong>and they never touch.</strong></p>
  <div class="grid two" style="margin-top:1.2rem;gap:26px">
    <div>
      <h3 style="margin:0 0 .4rem">Sancho&rsquo;s house &mdash; out of <em>Córdoba</em></h3>
      <p class="cap" style="margin:0 0 .6rem">Andalusia &rarr; Canelones 1791 &rarr; Montevideo</p>
      <Spine rows={sanchoHouse} u={u} archiveKey="lerena" idPrefix="sanchohouse-" />
    </div>
    <div>
      <h3 style="margin:0 0 .4rem">Ramón&rsquo;s house &mdash; out of <em>Valdemoro</em></h3>
      <p class="cap" style="margin:0 0 .6rem">Castilla la Nueva &rarr; Rosario, Colonia &rarr; the interior</p>
      <Spine rows={ramonHouse} u={u} archiveKey="lerena" idPrefix="ramonhouse-" />
    </div>
  </div>
  <div class="grid two" style="margin-top:26px;gap:26px">
    <div>
      <h3 style="margin:0 0 .4rem">And the line this archive is looking for</h3>
      <p class="cap" style="margin:0 0 .6rem">Rosario de Santa Fe &rarr; the Cape &rarr; Brisbane</p>
      <Spine rows={argentineLine} u={u} archiveKey="lerena" idPrefix="argentineline-" />
    </div>
    <div style="align-self:center">
      <div class="panel" style="border-left:3px solid var(--terra);margin:0">
        <div class="lab">Why it is drawn to the same scale</div>
        <p style="margin:.6rem 0 0">Both Uruguayan houses run <strong>four generations</strong> and reach
          back to a named couple in Spain. <strong>Pablo Armando&rsquo;s runs two, and stops at a pair of
          names on one card.</strong></p>
        <p style="margin:.6rem 0 0">That is not a gap in the research. It is the whole problem, and it is
          why the Uruguayan work is done <em>in parallel and in hope</em> rather than as his line.
          <strong>Nothing yet connects the left of this page to the right of it.</strong></p>
      </div>
    </div>
  </div>

  <p class="cap" style="margin-top:16px"><strong>Five hundred kilometres apart in Spain, and about
    ninety in Uruguay.</strong> Sancho married at Canelones and Ramón baptised at the Iglesia Matriz of
    Montevideo — one year apart, in the same small city, at the same font — having come from opposite
    ends of the same country.</p>
</section>

<section class="blk">
  <h2>Ramón&rsquo;s house, record by record</h2>
  <p class="dek">Found on 17 September 2026 by searching the free FamilySearch collections
    <em>by parent</em> rather than by person. Every line is an index entry; where an image exists and has
    not been read, it says so.</p>
