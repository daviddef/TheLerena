---
/* ONE FAMILY, drawn from the register.   17 October 2026.
 *
 * /taylor/ is hand-written, because the Taylors are the line's own people and have been researched generation by
 * generation. These are not: they are the names the register holds in numbers, and what a page may say about them is
 * only what the register holds. So the page is built (src/lib/families.js) from people.json, the file every person page
 * is built from, plus data/families.tsv for the spellings that count as one name and the places this archive already
 * writes the family up. There is no prose about a family typed anywhere in this template or that file.
 *
 * WHO IS LISTED: never a living person, never a person held out of publication. The filter runs before anything is
 * counted or linked, and tools/check-families.py reads the BUILT page to prove it.
 *
 * A SHARED SURNAME IS NOT A RELATIONSHIP. This archive's subject is a name, and the page says so wherever the people
 * under it are gathered by the name and not joined to one another. */
import Base from "../../layouts/Base.astro";
import Placement from "../../components/Placement.astro";
import { u } from "../../lib/url.js";
import ring from "@daviddef/archive-kit/data/archives.json";
import { buildFamily, families, lifeOf, placeOf, fold } from "../../lib/families.js";
import fams from "../../data/families.json";

export function getStaticPaths() {
  return fams.map((f) => ({ params: { slug: f.slug }, props: { slug: f.slug } }));
}
const { slug } = Astro.props;
const f = families.find((x) => x.slug === slug);
const b = buildFamily(f);
const n = b.bearers.length;
const NUM = ["no", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"];
const word = (k) => NUM[k] ?? String(k);
const people_ = n === 1 ? "person" : "people";
const yrs = b.span ? (b.span[0] === b.span[1] ? `${b.span[0]}` : `${b.span[0]} to ${b.span[1]}`) : "";
const oneYear = b.span && b.span[0] === b.span[1];
const spell = b.spellings.length > 1 ? b.spellings.slice(0, -1).join(", ") + " and " + b.spellings.slice(-1) : b.spellings[0] || f.name;
const conn = b.byStatus.connected || 0;
const excl = b.byStatus.excluded || 0;

const standing = n === 1
  ? (conn ? ", and is connected to the line" : ", and is not yet connected to the line")
  : (conn === n ? ". All of them are connected to the line"
     : conn ? `. ${word(conn)} ${conn === 1 ? "is" : "are"} connected to the line; the rest are gathered by the name alone`
     : ". None is yet connected to the line; they are gathered by the name alone");
const named = b.spellings.length > 1 ? `the name ${f.name}, written ${spell}` : `the name ${spell}`;
const dek = `${word(n)} ${people_} in this archive ${n === 1 ? "carries" : "carry"} ${named}` +
  (yrs ? (oneYear ? `, in a record of ${yrs}` : `, in records from ${yrs}`) : "") + standing + ".";

/* a sibling archive that keeps this family, from the estate's own ring: the surnames it lists, and its own sentence */
const sibling = ring.archives.find((a) => a.key !== "lerena" && (a.surnames || []).some((s) => f.forms.split("|").map(fold).includes(fold(s))));

const topPlaces = b.where.slice(0, 8);
const spouseWord = (c) => c.note ? c.note : "";
---
<Base title={`The ${f.name} family`}
      eyebrow={`${n} ${people_} of the name`}
      dek={dek}>

  <section class="blk">
    <p class="prose">This page gathers everyone the register holds under the {b.spellings.length > 1 ? "names" : "name"} <strong>{spell}</strong>, whether it is
      the first surname or the second. <strong>A shared surname is not a relationship</strong>: the sections below
      say which of these people the archive has joined to the line and to one another, and which it has only
      gathered. <a href={u("/families/")}>&larr; All the families</a></p>
  </section>

  <section class="blk">
    <h2 id="s-held">What the register holds</h2>
    <dl class="fkv">
      <div><dt>People</dt><dd>{n} {people_}{b.dated < n ? `, ${b.dated} with a year recorded` : ", each with a year recorded"}.</dd></div>
      {yrs && <div><dt>Years</dt><dd>{oneYear ? `${b.span[0]}, the only year in their dates.` : `From ${b.span[0]} to ${b.span[1]}, the earliest and latest year in any of their dates.`}</dd></div>}
      {b.spellings.length > 1 && <div><dt>Written</dt><dd>{b.spellings.join(", ")} &mdash; spellings this archive counts as one name (<span class="mono">data/families.tsv</span>).</dd></div>}
      {topPlaces.length > 0 && <div><dt>Where</dt><dd>{topPlaces.map((w, i) => (<>{i ? " · " : ""}<a href={u(`/places/${w.slug}/`)}>{w.name}</a>{w.n > 1 ? ` (${w.n})` : ""}</>))}{b.unfiled ? <span class="cap"> &mdash; and {b.unfiled} filed under no place.</span> : null}</dd></div>}
      <div><dt>Placed</dt><dd>{Object.entries(b.byStatus).sort((x, y) => ["connected","high","interest","unplaced","excluded"].indexOf(x[0]) - ["connected","high","interest","unplaced","excluded"].indexOf(y[0])).map(([k, c], i) => (<>{i ? " " : ""}<span class={k === "connected" ? "chip doc" : k === "excluded" ? "chip" : k === "high" ? "chip lore" : "chip inf"}>{k === "connected" ? "Connected to the line" : k === "high" ? "Unplaced · high interest" : k === "interest" ? "Unplaced · of interest" : k === "excluded" ? "Excluded" : "Unplaced"} &middot; {c}</span></>))}</dd></div>
      {b.alsoLerena > 0 && <div><dt>And Lerena</dt><dd>{b.alsoLerena === n ? "All" : b.alsoLerena} of them also carry the name Lerena, as the first or the second surname.</dd></div>}
    </dl>
  </section>

  {(b.onLine.length > 0 || b.ancestors.length > 0 || b.marriedIn.length > 0) && (
    <section class="blk">
      <h2 id="s-line">On the direct line</h2>
      <div class="prose" style="margin-top:12px">
        {b.onLine.length > 0 && <p>On the line itself: {b.onLine.map((p, i) => (<>{i ? ", " : ""}<a href={u(`/people/${p.slug}/`)}>{p.name}</a></>))}.</p>}
        {b.ancestors.length > 0 && <p>Ancestors of someone on the line, by the relationships the register draws: {b.ancestors.map((p, i) => (<>{i ? ", " : ""}<a href={u(`/people/${p.slug}/`)}>{p.name}</a></>))}.</p>}
        {b.marriedIn.length > 0 && <p>Married into the line: {b.marriedIn.map((p, i) => (<>{i ? ", " : ""}<a href={u(`/people/${p.slug}/`)}>{p.name}</a></>))}.</p>}
        <p class="cap">The line is set out generation by generation, with the record behind every step, on <a href={u("/direct-line/")}>the Spine</a> and drawn on <a href={u("/tree/")}>the tree</a>.</p>
      </div>
    </section>
  )}

  <section class="blk">
    <h2 id="s-how-we-know">How the archive knows</h2>
    <div class="prose" style="margin-top:12px">
      {b.edges > 0 ? (
        <p>Of the <strong>{b.edges}</strong> relationship{b.edges === 1 ? "" : "s"} drawn between {n === 1 ? "this person" : "these people"} and the
          people {n === 1 ? "they are" : "they are"} joined to, <strong>{b.reg}</strong>{b.reg === 1 ? " is" : " are"} written in a record this archive has read{b.tree > 0 ? <> and <strong>{b.tree}</strong> come{b.tree === 1 ? "s" : ""} from a family chart or a user-contributed tree, <strong>unverified</strong>.</> : <>.</>}</p>
      ) : (
        <p><strong>No relationship is drawn for {n === 1 ? "this person" : "any of these people"}</strong> in the register: {n === 1 ? "they are" : "they are"} held by name and nothing more.</p>
      )}
      <p class="cap">The grades behind these words are on <a href={u("/method/#ladder")}>the Method page</a>. Each person's own
        page says what record produced them.</p>
      {excl > 0 && <p><strong>{word(excl)} of them {excl === 1 ? "has" : "have"} been excluded</strong> &mdash; checked, and shown not to belong to this family. They are kept in the list rather than deleted, so the next person who searches the name does not repeat the work.</p>}
    </div>
  </section>

  <section class="blk">
    <h2 id="s-people">The people</h2>
    <p class="dek">Oldest first by recorded birth year; those with no year follow. Every name here has a page of its own.</p>
    <div class="scroll" style="margin-top:14px">
      <table>
        <thead><tr><th>Name</th><th>Dates</th><th>Place</th><th>Standing</th></tr></thead>
        <tbody>
          {b.bearers.map((p) => (
            <tr>
              <td><a href={u(`/people/${p.slug}/`)}>{p.name}</a></td>
              <td class="mono">{lifeOf(p)}</td>
              <td>{placeOf(p)}</td>
              <td><Placement c={p.status} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {b.couples.length > 0 && (
    <section class="blk">
      <h2 id="s-married">Couples</h2>
      <p class="dek">Every couple the register draws for a person of this name &mdash; a marriage, or parents together &mdash; with what the register says about it.</p>
      <div class="scroll" style="margin-top:14px">
        <table>
          <thead><tr><th>One</th><th>The other</th><th>What the register says</th></tr></thead>
          <tbody>
            {b.couples.map((c) => (
              <tr>
                <td><a href={u(`/people/${c.a.slug}/`)}>{c.a.name}</a></td>
                <td><a href={u(`/people/${c.b.slug}/`)}>{c.b.name}</a></td>
                <td class="cap">{spouseWord(c)}{c.via === "tree" ? <> <span class="chip lore">family chart, unverified</span></> : null}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {b.connections.length > 0 && (
    <section class="blk">
      <h2 id="s-joined">Joined to these families</h2>
      <p class="dek">The other names carried by their husbands, wives, parents and children, counted once per person. A name is a link where this archive has a page for that family.</p>
      <ul class="plain" style="margin-top:14px;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:10px 18px">
        {b.connections.map((c) => (
          <li>{c.href ? <a href={u(c.href)}><strong>{c.label}</strong></a> : <strong>{c.label}</strong>}
            <span class="cap" style="margin:0 0 0 4px">{c.n} {c.n === 1 ? "person" : "people"}</span></li>
        ))}
      </ul>
    </section>
  )}

  {f.read.length > 0 && (
    <section class="blk">
      <h2 id="s-read">Where this archive writes the family up</h2>
      <ul style="margin-top:12px">
        {f.read.map((r) => (<li><a href={u(r.href)}>{r.label}</a></li>))}
      </ul>
    </section>
  )}

  {sibling && (
    <section class="blk">
      <h2 id="s-sibling">In a sibling archive</h2>
      <p class="prose"><a href={sibling.url} rel="noopener">{sibling.name}</a> keeps this name among its own: <em>{sibling.line}</em></p>
    </section>
  )}

  <section class="blk" style="border-bottom:0">
    <p class="cap">This page is built from <span class="mono">data/lerena-register.tsv</span> and <span class="mono">data/relations.tsv</span>
      through <span class="mono">site/src/data/people.json</span>, and from <span class="mono">data/families.tsv</span>, so it cannot fall out of step with the register.
      <a href={u("/families/")}>All the families</a> &middot; <a href={u("/people/")}>The People</a> &middot; <a href={u("/register/")}>The Register</a></p>
  </section>

  <style>
    .fkv { margin: 14px 0 0; display: grid; grid-template-columns: minmax(0, 130px) 1fr; }
    .fkv > div { display: contents; }
    .fkv dt { font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .11em; text-transform: uppercase;
              color: var(--ink-3); padding: 12px 14px 12px 0; border-bottom: 1px solid var(--rule); }
    .fkv dd { margin: 0; padding: 9px 0; border-bottom: 1px solid var(--rule); color: var(--ink); font-family: var(--sans);
              font-size: 14.5px; line-height: 1.55; overflow-wrap: anywhere; }
    @media (max-width: 560px) {
      .fkv { grid-template-columns: 1fr; }
      .fkv dt { padding: 12px 0 0; border-bottom: 0; }
      .fkv dd { padding: 2px 0 10px; }
    }
  </style>
</Base>
