---
import Base from "../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import { u } from "../lib/url.js";
import people from "../data/people.json";
import { emph, plain } from "../lib/text.js";
import Register from "@daviddef/archive-kit/components/Register.astro";
import nf from "../data/namefold.json";
import alive from "../data/last-attested-alive.json";
/* THE SEARCH BOX FOLDS SPELLINGS. Built by the kit's namefold.py from this
   archive's own corpus, and deliberately narrow: it folds only forms that are
   one word two keyboards wrote differently - an accent, a capital. Anything
   that changes a LETTER is printed by the tool and left off, because whether
   two spellings are one family is this archive's judgement and not a rule's.
   Folding is a search rule. It widens what a query matches and merges nothing. */

const total = people.length;
const distinct = new Set(people.map(p => p.name.trim().toLowerCase())).size;
const linked = people.filter(p => p.sourceUrl).length;
const unlinked = total - linked;

const nUnplaced = people.filter(p => ["unplaced", "high", "interest"].includes(p.status)).length;
const nConnected = people.filter(p => p.status === "connected").length;
const nExcluded = people.filter(p => p.status === "excluded").length;

const CHIP = { connected: ["doc", "Connected"], excluded: ["", "Excluded"],
               high: ["lore", "Unplaced · high interest"], interest: ["inf", "Unplaced · of interest"],
               unplaced: ["inf", "Unplaced"] };

// What the source says: the record's own content, in one line, Falco-style.
function saysOf(p) {
  const bits = [];
  if (p.born && p.born !== "-") bits.push(p.born);
  if (p.birthplace && p.birthplace !== "-") bits.push(p.birthplace);
  if (p.nationality && p.nationality !== "-") bits.push(p.nationality);
  if (p.occupation && p.occupation !== "-") bits.push(p.occupation);
  if (p.where && p.where !== "-") bits.push("found in " + p.where);
  return bits.join(" · ");
}

/* A near-fork: the same three columns, the same search, the same grouping into
   a section per spelling. No hay - every word of a row is in the row, and the
   shared script reads it there rather than shipping a second copy. The seventy-
   odd spelling headings become the surname facet, so a reader after one
   spelling gets it in a click and the search still runs across all of them. */
const enriched = people.map(p => ({
  ...p,
  says: saysOf(p),
  chip: CHIP[p.status] || CHIP.unplaced,
}));

const regRows = [...enriched]
  .sort((a, b) => a.surname.localeCompare(b.surname) || a.name.localeCompare(b.name))
  .map(p => ({
    name: p.name,
    surname: p.surname,
    href: `/people/${p.slug}/`,
    kind: p.chip[1],
    chip: p.chip[1],
    detail: emph(p.says) + (p.note ? `<br><span class="cap">${emph(p.note)}</span>` : ""),
    source: emph(p.source),
    sourceHref: p.sourceUrl || "",
    sourceLabel: p.sourceUrl ? "record" : (p.noLink || "no public link"),
  }));

const groups = Object.values(
  enriched.reduce((acc, p) => {
    (acc[p.surname] ||= { surname: p.surname, rows: [] }).rows.push(p);
    return acc;
  }, {})
).sort((a, b) => b.rows.length - a.rows.length || a.surname.localeCompare(b.surname));
for (const g of groups) g.rows.sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="The Register"
      eyebrow="Every named individual this archive has found"
      dek="Every person of this surname, and every spouse and parent of one, met in the course of the research — searchable, grouped by the spelling the record used, with the source that names each one. This is the raw catch, not a family tree, and most of it is not this family.">

<NameLists here="register" u={u} />



<section class="blk">
  <p class="lede">{total} entries for {distinct} distinct names, <strong>{linked}</strong> of them with a
    link to the source that names them; the other <strong>{unlinked}</strong> say in the Source column why
    no link exists.</p>
</section>

<section class="blk">
  <h2>Read this before you read the list</h2>
  <div class="prose">
    <p>The surname is rare. Forebears counts about <strong>2,124 Lerenas worldwide</strong>, with the
      highest density anywhere in <strong>Uruguay</strong> — the signature of a small founding group that
      emigrated. At that scale most people carrying the name probably <em>are</em> related to one another
      at some depth. But &ldquo;probably related&rdquo; is not evidence, and <strong>a shared surname is
      not a relationship</strong>.</p>
    <p>Most entries here come from <strong>surname sweeps</strong> — every Lerena in the CEMLA arrival
      index, in the Argentine national censuses of 1869 and 1895, in the Uruguayan and Argentine parish
      and civil registers, in the South African death, estate and cemetery indexes. They are here because
      they were found, not because they are kin. <strong>None is claimed as kin.</strong></p>
    <p>The list is <strong>grouped by the spelling the record used</strong> — Lerena, Llerena, Larena,
      Lorena, Lerina — because the spelling is evidence in itself: it is how a clerk heard the name, and
      the clerks disagreed. Names in other groups are spouses and parents who married in or are named
      alongside.</p>
    <p class="cap">Three marks are used. <strong>Connected</strong> — proven to the direct line.
      <strong>Excluded</strong> — checked and shown not to belong. <strong>Unplaced</strong> — found,
      recorded, and honestly unresolved. Most are unplaced, and that is the point of the page.</p>
    <p>The moment more of Pablo Armando&rsquo;s people are named, this becomes the place to look — several
      of these may snap into position at once, and the work of finding them will already have been done.
      <a href={u("/enrolment-card/")}>The card that named his parents &rarr;</a></p>
  </div>
  <div class="grid g3" style="margin-top:22px">
    <div class="panel"><div class="nm">{total}</div><div class="txt">entries recorded</div></div>
    <div class="panel"><div class="nm">{nUnplaced}</div><div class="txt">unplaced — the honest majority</div></div>
    <div class="panel"><div class="nm">{nConnected} / {nExcluded}</div><div class="txt">connected / excluded</div></div>
  </div>
</section>

<section class="blk">
  <h2>Filter by name, place, year or source</h2>
  <Register rows={regRows} u={u} unit="entries" fold={nf.fold} />
</section>

<section class="blk">
  <h2>Why keep a list of people who are probably not us</h2>
  <p class="prose">Because the alternative is finding them twice. Every one of these cost a search, and a
    search that is not written down has to be paid for again. When a record turns up a
    <em>Juan Carlos</em>, or a Lerena at Rosario, or a family that moved between the two banks of the
    Plate, the question will be whether this archive has met them before — and this is the only page that
    can answer it. <a href={u("/searched/")}>What has been read &rarr;</a></p>
</section>

<section class="blk">
  <h2 id="s-last-alive">Last demonstrably alive &mdash; and how little that is known</h2>
  <div class="prose">
    <p>This register records when a person was <strong>named</strong>. It has never recorded when they
    were last <strong>alive</strong>, and the two are not the same: a man named as a grandfather on an
    1880 act may have been twenty years dead. Computed, never typed, by
    <span class="mono">tools/last-alive.py</span>.</p>
    <p>The result is worth stating plainly.
    <strong>{alive.filter((r) => /DEATH/.test(Object.values(r)[4])).length} of {alive.length} people
    are known to have died at all.</strong> The remaining
    {alive.filter((r) => /BIRTH|UNKNOWN/.test(Object.values(r)[4])).length} carry
    <strong>a birth estimate and nothing more</strong> &mdash; a floor below which they certainly
    existed, not evidence they survived to anything later.</p>
    <p>Two tiers, and the difference matters. <strong>DEATH</strong> is an explicit date on the
    person's own row. <strong>DEATH BY</strong> is a ceiling taken from a record that only exists
    because someone died &mdash; an estate or death-notice file &mdash; and it is
    <strong>never treated as the date</strong>: this archive has already been caught once, when Anton
    Armando died in April 2003 and his estate was advertised in 2013, ten years later.</p>
  </div>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr>
        <th style="width:18rem">Person</th><th style="width:7rem">Born</th>
        <th style="width:7rem">Last alive</th><th>On what basis</th>
      </tr></thead>
      <tbody>
        {alive.filter((r) => /DEATH/.test(Object.values(r)[4])).map((r) => {
          const c = Object.values(r);
          return (
            <tr>
              <th>{c[0]}</th><td>{c[1]}</td><td><strong>{c[2]}</strong></td>
              <td class="cap">{c[3]}</td>
            </tr>);
        })}
      </tbody>
    </table>
  </div>
  <div class="prose" style="margin-top:12px">
    <p class="dim">Only the people known to have died are listed. The other
    {alive.filter((r) => /BIRTH|UNKNOWN/.test(Object.values(r)[4])).length} are in
    <span class="mono">data/last-attested-alive.tsv</span>, each marked for what it is.</p>
  </div>
</section>

</Base>
