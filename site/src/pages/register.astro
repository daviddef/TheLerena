---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import people from "../data/people.json";
const total = people.length;
const nUnplaced = people.filter(p => p.status === "unplaced" || p.status === "high" || p.status === "interest").length;
const nConnected = people.filter(p => p.status === "connected").length;
const nExcluded = people.filter(p => p.status === "excluded").length;
const CHIP = { connected: ["doc","Connected"], excluded: ["","Excluded"],
               high: ["lore","Unplaced · high interest"], interest: ["inf","Unplaced · of interest"],
               unplaced: ["inf","Unplaced"] };
const rows = people.map(p => ({
  ...p,
  hay: [p.name, p.born, p.birthplace, p.nationality, p.occupation, p.where, p.source, p.note, p.status]
        .join(" ").toLowerCase(),
  chip: CHIP[p.status] || CHIP.unplaced,
}));
---
<Base title="Name Register"
      eyebrow="Every Lerena encountered anywhere, placed or not"
      dek="A working register of every person of this surname met in the course of the research — searchable, with the record that produced each one, and an honest mark saying whether they connect to our line, do not, or cannot yet be told either way.">

<section class="blk">
  <h2>Why keep this</h2>
  <div class="prose">
    <p>The surname is rare. Forebears counts about <strong>2,124 Lerenas worldwide</strong>, with the
      highest density anywhere in <strong>Uruguay</strong> — the signature of a small founding group that
      emigrated. At that scale, most people carrying the name probably <em>are</em> related to one another
      at some depth. But &ldquo;probably related&rdquo; is not evidence, and this archive does not publish
      guesses as findings.</p>
    <p>So every Lerena met along the way is written down here rather than discarded, with the record that
      produced them. <strong>None is claimed as kin.</strong> The moment Pablo Armando&rsquo;s parents are
      named, this list becomes the place to look — several of these people may snap into position at once,
      and the work of finding them again will already have been done.</p>
    <p class="cap">Three marks are used. <strong>Connected</strong> — proven to the direct line.
      <strong>Excluded</strong> — checked and shown not to belong. <strong>Unplaced</strong> — found,
      recorded, and honestly unresolved. Most are unplaced, and that is the point of the page.</p>
  </div>
  <div class="grid g3" style="margin-top:22px">
    <div class="panel"><div class="nm">116</div>
    <div class="txt">people recorded</div></div>
    <div class="panel"><div class="nm">{nUnplaced}</div>
    <div class="txt">unplaced — the honest majority</div></div>
    <div class="panel"><div class="nm">{nConnected} / {nExcluded}</div><div class="txt">connected / excluded</div></div>
  </div>
</section>

<section class="blk">
  <h2>Search the register</h2>
  <p class="dek">Type any name, place, year, source or status — for instance <em>Trinidad</em>,
    <em>Gilberto</em>, <em>1882</em>, <em>CEMLA</em>, <em>connected</em>.</p>
  <input id="q" type="search" placeholder="Search all 116 people…"
         autocomplete="off"
         style="width:100%;margin-top:16px;padding:14px 16px;font:inherit;font-size:1.05rem;
                background:var(--panel);color:var(--ink);border:1px solid var(--rule);border-radius:2px" />
  <p id="count" class="cap" style="margin-top:10px">Showing all 116 people.</p>
  <div class="scroll" style="margin-top:14px">
    <table id="reg">
      <thead><tr><th>Person</th><th>Born</th><th>Nationality</th><th>Where found</th><th>Source</th><th>Status</th></tr></thead>
      <tbody>
      {rows.map(p => (
        <tr data-s={p.hay}>
          <td><a href={u(`/people/${p.slug}/`)}><strong>{p.name}</strong></a>
            {p.note && <><br /><span class="cap">{p.note}</span></>}</td>
          <td class="m">{p.born}</td>
          <td>{p.nationality}</td>
          <td>{p.where}</td>
          <td>{p.source}</td>
          <td><span class={`chip ${p.chip[0]}`.trim()}>{p.chip[1]}</span></td>
        </tr>
      ))}
      </tbody>
    </table>
  </div>
  <p id="none" class="note" style="margin-top:18px;display:none">Nothing matches that. Try a shorter word —
    a surname, a place, or a year.</p>
</section>

<section class="blk">
  <h2>How to add to this</h2>
  <p class="prose">The register lives at <span class="mono">data/lerena-register.tsv</span> and this page is
    generated from it, so the two cannot drift apart. A person earns a row the moment they are
    <em>seen in a record</em>, not when they are understood. If you meet a Lerena anywhere — a headline, a
    headstone, a passenger list, a race card — the useful thing is the <strong>citation</strong>, not the
    conclusion. Conclusions can be drawn later; a source seen once and not written down is lost.</p>
</section>

<script is:inline>
  (function () {
    var q = document.getElementById('q');
    var rows = Array.prototype.slice.call(document.querySelectorAll('#reg tbody tr'));
    var count = document.getElementById('count');
    var none = document.getElementById('none');
    if (!q) return;
    function run() {
      var terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      var shown = 0;
      rows.forEach(function (r) {
        var hay = r.getAttribute('data-s') || '';
        var ok = terms.every(function (t) { return hay.indexOf(t) !== -1; });
        r.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = terms.length
        ? ('Showing ' + shown + ' of ' + rows.length + ' people.')
        : ('Showing all ' + rows.length + ' people.');
      none.style.display = shown ? 'none' : '';
    }
    q.addEventListener('input', run);
  })();
</script>

</Base>
