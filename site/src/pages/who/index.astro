---
/* Every name in the archive, and how many people bore it. One page per person (23 November 2026): a name no longer has a page of its
   own, so each entry here goes straight to the person page(s) of that name: one link for a name one person bears, and every bearer
   listed for a name several people bear. */
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import EveryName from "@daviddef/archive-kit/components/EveryName.astro";
import { u } from "../../lib/url.js";
import { yearIn } from "../../lib/namesets.js";
import { SETS, firstOf, isShared, byAge, SECTION_ID } from "../../lib/namesakes.js";

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
const names = [...SETS.values()].map((s) => {
  const first = firstOf(s);
  return {
    slug: s.key, name: s.name, n: s.people.length,
    href: u(`/people/${first.slug}/`) + (isShared(s) && first.living !== true ? `#${SECTION_ID}` : ""),
    /* every bearer of a shared name, each a link to that person's own page, with the year born where the register gives one (the names read
       alike, so the year is what tells the links apart); a living person is "a living person" and nothing more */
    detail: isShared(s)
      ? s.people.slice().sort(byAge).map((b) => {
          const yr = yearIn(b.born);
          return `<a href="${esc(u(`/people/${b.slug}/`))}">${b.living === true ? "a living person" : esc(b.name) + (yr ? ` (b. ${yr})` : "")}</a>`;
        }).join("<br>")
      : "",
  };
}).sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
const shared = names.filter((n) => n.n > 1);
/* EveryName draws each name as a link to /who/<slug>/; hand it the person page instead */
const hrefOf = new Map(names.map((n) => [`/who/${n.slug}/`, n.href]));
const toPerson = (p) => hrefOf.get(p) ?? u(p);
---
<Base title="Every Name" noAutolink
      eyebrow={`${names.length} names · ${shared.length} held by more than one person`}
      dek="A name is not a person. This is every name in the archive, and how many different people bore it. Each links to the person: a name more than one person bears lists them all.">

<NameLists here="who" u={u} />


  <section class="blk">
    <EveryName names={names} u={toPerson} detailLabel="Everyone of this name" />
  </section>
</Base>
