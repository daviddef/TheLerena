---
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import { u } from "../../lib/url.js";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import people from "../../data/people.json";
import { emph } from "../../lib/text.js";
const order = { connected:0, high:1, interest:2, unplaced:3, excluded:4 };
const sorted = [...people].sort((a,b) => (order[a.status]-order[b.status]) || a.name.localeCompare(b.name));
const n = people.length;
const conn = people.filter(p=>p.status==="connected").length;
const excl = people.filter(p=>p.status==="excluded").length;
const unpl = people.filter(p=>p.status==="unplaced").length;
const NUM = ["no","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten",
             "Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen"];
const word = (k) => NUM[k] ?? String(k);

/* The status is the whole argument of this page - that a rare surname produces
   a majority of unplaced people, and that this is what the work looks like
   before the connecting document turns up - and it was sortable but not
   askable. It is the facet now. No hay: every word of a row is in the row, and
   the shared script reads it from there rather than shipping a second copy. */
const STATUS = { connected: "Connected to the line", high: "High interest",
  interest: "Of interest", unplaced: "Unplaced", excluded: "Excluded" };
const counted = Object.keys(STATUS)
  .map((k) => [k, people.filter((p) => p.status === k).length]).filter(([, n]) => n > 0);
const esc = (t) => String(t ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
---
<Base title="The People" eyebrow={`${n} people of this surname, each with their own page`}
      dek="Every Lerena this archive has met, anywhere, with the record that produced them. Search the list and follow any name through to what is known about that person.">
<NameLists here="people" u={u} />


<section class="blk">
  <p class="prose">{word(conn)} are <strong>connected</strong> to the direct line. {word(excl)} have been
    <strong>excluded</strong> — checked and shown not to belong. The remaining {unpl} are
    <strong>unplaced</strong>: found, recorded, and honestly unresolved. That majority is not a failure of
    the work; it is what a rare surname looks like before the connecting document turns up.</p>
</section>

<section class="blk">
  <FilterTable
    unit="people"
    columns={[{ label: "Name" }, { label: "Born", cls: "mono" }, { label: "Where" },
              { label: "Standing", cls: "small" }, { label: "On the word of", cls: "small" }]}
    facets={[{ key: "status", label: "Standing", all: `All ${n}`,
               options: counted.map(([k, c]) => ({ v: k, label: `${STATUS[k]} (${c})` })) }]}
    rows={sorted.map((p) => ({
      facets: { status: p.status },
      cells: [
        `<a href="${u(`/people/${p.slug}/`)}"><strong>${esc(p.name)}</strong></a>` +
          (p.occupation ? `<div class="cap" style="margin-top:3px">${esc(p.occupation)}</div>` : ""),
        esc(p.born || ""),
        esc([p.place, p.nationality].filter(Boolean).join(" \u00b7 ")),
        `<span class="chip">${STATUS[p.status] || p.status}</span>`,
        emph(p.source || ""),
      ],
    }))} />
</section>


</Base>
