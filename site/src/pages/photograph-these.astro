---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Shotlist from "@daviddef/archive-kit/components/Shotlist.astro";
import { u } from "../lib/url.js";
import rows from "../data/photograph-these.json";
import { emph, plain } from "../lib/text.js";

/* 21 September 2026. The panel moved to the kit. The ORDER did not: these are
   ranked by what the picture would settle, numbered rather than graded, which
   is a different question from Blazevic's (how much effort is the trip worth)
   and Defranceski's (which day of the walk). And `what_to_capture` stays its
   own line rather than being folded into the prose, because that line is the
   difference between a useful trip and a wasted one. */
const groups = [{
  rows: rows.map((r) => ({
    tag: r.priority,
    where: r.where,
    what: emph(r.what),
    why: emph(r.why_it_matters),
    capture: r.what_to_capture,
    colour: r.priority === "1" ? "var(--accent)" : null,
  })),
}];
---
<Base title="Photograph these"
      eyebrow={`${rows.length} places · all of them in Cape Town`}
      dek="Everything this archive would like a picture of, and cannot take itself. Each says what the photograph would settle, and what to capture — because a photograph of the wrong part of a thing is a wasted trip.">

<section class="blk">
  <div class="prose">
    <p>All six are within half an hour of each other. <strong>Someone with a morning and a camera could
      close the first two.</strong></p>
  </div>
</section>

<Rule name="star" label="In order of what the picture would settle" />

<section class="blk">
  {/* Carried visually by the Rule above; here so the document does not jump h1 -> h3. */}
  <h2 class="vh">In order of what the picture would settle</h2>
  <Shotlist groups={groups} u={u} />
</section>

<section class="blk">
  <div class="note"><strong>The first one already has a photograph, and it is not enough.</strong> A
    stranger photographed that kerb in 2021 and published it through eGGSA; it shows the surname and no
    more. <a href={u("/south-africa/")}>What the cemetery records say &rarr;</a></div>
</section>
</Base>
