---
import Base from "../layouts/Base.astro";
import WaysIn from "@daviddef/archive-kit/components/WaysIn.astro";
import Numbers from "@daviddef/archive-kit/components/Numbers.astro";
import PlaceSpark from "@daviddef/archive-kit/components/PlaceSpark.astro";
import MarriageChart from "@daviddef/archive-kit/components/MarriageChart.astro";
import { chartGroups } from "../lib/marriedin.js";
import { u } from "../lib/url.js";
import people from "../data/people.json";
import atlas from "../../public/atlas-data.json";
import corrections from "../data/corrections.json";
import sourcesConsulted from "../data/sources-consulted.json";
import errands from "../data/errands.json";
import places from "../data/places.json";
// Derived, not typed. A hand-written count here went stale within the week it was written.
const WORDS = ["no","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen"];
/* Six tiles, all of them measures of the work. There were ten, and two of them
   were not numbers at all — "Juan Carlos" and "Uruguayan". Those are two of the
   best findings this archive has made and they deserve better than being shaped
   into a statistic: they are in the cards and on their own pages, in sentences,
   where they can say what they actually mean.

   The years went the same way. 1882, 1911, 1931 are the spine of the story and
   belong to the story. A tile is for saying how much work stands behind the
   archive, and it should change as the work grows — so these are counted at
   build time rather than typed in. */
const stats = [
  [people.length, "people published, each graded for how well it is evidenced", "/people/"],
  [places.length, "places named, with the people this archive can put in each", "/places/"],
  [sourcesConsulted.length, "sources consulted, each listed with what it was used for", "/sources/"],
  [corrections.length, "claims this archive has corrected, with how each was caught", "/corrections/"],
  [errands.length, "enquiries raised with an archive or an office, and what came back", "/errands/"],
  ["2,124", "people bear this surname in the whole world", "/name/"],
];
---
<Base title="The Lerena Archive"
      eyebrow="Rosario · the Cape · the Rand · Brisbane"
      dek="A horse-dealer out of Argentina, a stable under Table Mountain, and four family traditions tested against the record rather than repeated."
      bare={true}>

<section class="hero">
  <img src={u("/art/banner.webp")}
       alt="A painted impression of a stable yard on the sand flats north of Cape Town, Table Mountain in the distance, two horses standing in the open."
       loading="eager" decoding="async" />
  <div class="cap">
    <div class="kick">A family history, kept honestly</div>
    <h1>Three generations back, a horseman out of Rosario.</h1>
    <p class="sub">Rosario · the Cape · the Rand · Brisbane — a family that kept Spanish names for eighty years in a country that had no use for them.</p>
  </div>
</section>
<p class="cap" style="margin-top:10px">A modern painted impression, not a photograph, and not a picture of any building this family is known to have owned — it stands for the yard at Rugby recorded in the 1931 building file. The signature in its corner is the image generator's invention.</p>

<section class="opener">
  <p class="lede">
    This archive was built for <b>David Defranceski</b>, born in Johannesburg, living in Brisbane — and it
    runs backwards from his mother: to <b>Germiston</b>, where her father died; to <b>Wynberg</b>, where her
    grandparents married in 1911 and their sons were baptised; to <b>Newlands</b>, where the horseman died
    in 1950; and to <b>Rosario de Santa Fe</b>, where his own passport says he was born and where the
    registers do not yet agree.
  </p>
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>the living are left out</b> — omitted, not hidden. And a
    second rule, which is harder: every claim says how well it is known.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <WaysIn doors={[
    { href: u("/direct-line/"), name: "Follow the line", blurb: "Three generations from Pablo Armando Lerena to David's mother, with a record behind every step and no inferred link left in the descent.", cta: "Start at Rosario →" },
    { href: u("/passport/"), name: "Read the passport", blurb: "Série A No. 07962, issued at Cape Town on Christmas Eve 1940. A birthplace, a birthday, and a profession in one word: Trainer.", cta: "See what it settles →" },
    { href: u("/hypotheses/"), name: "See what is unproved", blurb: "Every proposition the archive is entertaining but has not proved — what suggests it, what would settle it, and the two already retired as wrong.", cta: "Open questions →" },
  ]} />
</section>

<section class="blk">
  <div class="panel" style="border-left:3px solid var(--accent)">
    <div class="kick" style="margin-bottom:8px">13 September 2026</div>
    
  <section class="feat">
    <h2 style="margin-top:6px">Where this family can actually be put</h2>
    <p class="dek" style="margin-top:10px">The River Plate, the Cape, and the English west country. <strong>Every dot is a place this archive can put a named person in, and its size is how many stand there.</strong> The biggest are labelled; the colours are this archive's own regions. The coast and the borders under them are real — Natural Earth, clipped to this frame — so a dot can be read as somewhere rather than as a position in an empty box.</p>
  <PlaceSpark places={atlas.places} href={u("/atlas/")}
              label={`${atlas.places.length} places, the River Plate, the Cape, and the English west country`} />
  </section>
<h2 style="margin-top:0">They were not a Rosario family.</h2>
    <p class="lede" style="margin-top:10px">Both volumes of the Rosario baptism index have now been read
      end to end &mdash; <b>1731 to 1901</b>. Across a hundred and seventy years the surname appears
      <b>once</b>, and the act behind that one entry says of both parents
      <b><i>&ldquo;naturales del E. Oriental&rdquo;</i></b>: natives of Uruguay.</p>
    <p style="margin-top:12px">No baptism for Pablo Armando, none for his father, no Lerena marriage in
      the parish register for 1867&ndash;1885, and not one Lerena in the 1895 national census of Santa Fe.
      Then the register itself was read <b>act by act, and the read now stands at <b>seven hundred and ninety-two consecutive baptisms</b>,
      to test whether the 1945 typescript index could be trusted at all. It agrees with the index
      everywhere.</p>
    <p style="margin-top:12px"><b>A household that lives in a parish leaves baptisms. This one leaves
      nothing</b> &mdash; which is no longer a gap in the searching but a fact about the family, and it
      points the search across the river.
      <a href={u("/searched/")}>What was read &rarr;</a> &middot;
      <a href={u("/hypotheses/")}>Hypothesis 1c &rarr;</a></p>
    <p class="cap" style="margin-top:12px">The same day, the Rosario <em>death</em> index was opened for
      the first time. Its two surviving L sections hold no Lerena either &mdash; and for
      <b>1840&ndash;1881</b> it has no L section at all: the book runs A to F and stops.
      <a href={u("/gaps/")}>The gaps &rarr;</a></p>
  </div>

  <div class="panel" style="border-left:3px solid var(--accent);margin-top:20px">
    <div class="kick" style="margin-bottom:8px">14 September 2026</div>
    <h2 style="margin-top:0">Across the river, the family is not obscure at all.</h2>
    <p class="lede" style="margin-top:10px">The panel above ends by pointing the search into Uruguay.
      It went. <b>Nuestra Se&ntilde;ora del Carmen la Mayor, the Cord&oacute;n, Montevideo, 13 December
      1831</b> &mdash; the baptism of a grandson of <b>Sancho Llerena</b>:
      <b><i>&ldquo;Fueron Padrinos Don Fructuoso Rivera, Presidente de la Rep&uacute;blica, y su esposa
      Do&ntilde;a Bernardina Fragoso&rdquo;</i></b>.</p>
    <p style="margin-top:12px"><b>The first constitutional President of Uruguay stood godfather</b>, with
      the first lady beside him. Godparents of that rank are not chosen at random &mdash; and everything
      found since runs the same way: Justiniana&rsquo;s father a <b>General</b>; C&aacute;ndido
      Juanic&oacute; an <b>abogado</b>; Luis Eugenio dead a <b>hacendado</b> in 1901; a daughter married
      to the philosopher <b>Jos&eacute; Pedro Massera</b>.</p>
    <p style="margin-top:12px">The Montevideo house is now documented from <b>Sancho&rsquo;s generation
      to the 1890s</b>: two marriages for Don Luis &mdash; the first, to <b>Carolina Oliva</b> in 1836,
      nobody here knew about &mdash; seven children for Luis Eugenio, eight for his brother
      <b>Gilberto Lerena</b>, co-founder of the Argentine Stud Book, whose family crossed to Buenos Aires
      between <b>October 1886 and October 1890</b>.
      <a href={u("/hypotheses/")}>The Uruguayan house &rarr;</a> &middot;
      <a href={u("/horses/")}>Gilberto &rarr;</a></p>
    <p class="cap" style="margin-top:12px"><b>And Juan Carlos Lerena is in none of it.</b> Fifteen people
      of that surname are now placed in two Montevideo generations, and Pablo Armando&rsquo;s father is
      not among them. That is the question, and it is still open.</p>
  </div>
</section>

<section class="blk">
  <div class="panel" style="border-left:3px solid var(--rule-strong)">
    <div class="kick" style="margin-bottom:8px">Before that &mdash; 10 September 2026</div>
    <h2 style="margin-top:0">His father has a name.</h2>
    <p class="lede" style="margin-top:10px">An Argentine army enrolment card — <em>clase de 1882</em>,
      born at <b>Rosario de Santa Fé</b>, enrolling office <b>Capetown</b> — names
      <b>Juan Carlos Lerena</b> and <b>María Lerena</b> as the parents of
      <b>Pablo Armando Lerena</b>. It had been sitting behind a machine-made index that spelled him
      <em>Armand Lorena</em> and placed him 1,400 km away in Salta.</p>
    <p class="cap" style="margin-top:12px">Corroborated from the other side of the ocean: his eldest son,
      named in the 1950 estate, was <b>Ricardo <em>Juan Carlos</em> Lerena</b>.
      <a href={u("/enrolment-card/")}>Read the card →</a></p>
  </div>
</section>

<section class="blk">
  <h2>What the family remembered, and how it has held up</h2>
  <p class="dek">Four traditions were handed down. Three now have documents; one has evidence against it.</p>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th style="width:15rem">The claim</th><th>Where it stands</th></tr></thead>
      <tbody>
        <tr><td><strong>An Argentine great-grandfather, from Rosario</strong></td>
          <td><span class="chip doc">Confirmed</span> His own passport gives <strong>Rosario de Santa Fe,
            22 February 1882</strong>, and records him as Argentine <em>by birth</em>. The tradition was
            exactly right. <a href={u("/passport/")}>The passport →</a></td></tr>
        <tr><td><strong>He brought horses</strong></td>
          <td><span class="chip doc">Confirmed</span> <strong>Trainer</strong> on his passport;
            <strong>horse-dealer</strong> at his marriage; the Argentine <strong>6th Cavalry</strong> in
            1915; <strong>Race Horse Owner</strong> at his death; a 1931 file for <strong>stables</strong>
            at Rugby; a yard that took apprentices; and, among his debts, a claim for
            <strong>£26 of carrots</strong>. <a href={u("/horses/")}>The horses →</a></td></tr>
        <tr><td><strong>He was Consul General</strong></td>
          <td><span class="chip inf">Disputed</span> Nothing supports it. On the 1940 passport the consular
            signature belongs to A. B. Bayne; Pablo Armando is the bearer. The family <em>did</em> hold an
            Argentine consular passport, which may be how the story began — and the family's own note says
            the post may have been <strong>Uruguayan</strong>.</td></tr>
        <tr><td><strong>He had an ostrich farm</strong></td>
          <td><span class="chip lore">Doubtful</span> The deeds registers show him holding no land at all,
            and every document places him in Cape Town racing rather than the Karoo. Not disproved —
            Oudtshoorn is unsearched, and a farm could have been leased.
            <a href={u("/south-africa/")}>South Africa →</a></td></tr>
      </tbody>
    </table>
  </div>
</section>


<section class="blk">
  <h2>Where it stands, and where it stops</h2>
  <div class="prose">
    <p>The line is closed and documented from <b>Pablo Armando Lerena</b> — born 1882, died at Newlands in
      1950 — through <b>Nuno Fernando Lerena</b> to David's mother. His wife <b>Mary Septima Taylor</b> can
      be traced four generations further, to a <b>James Taylor born about 1796</b> in Suffolk, and a family
      settled at Bideford and Northam in north Devon.</p>
    <p>Above him the line now runs one generation further, to <b>Juan Carlos Lerena</b> and
      <b>María Lerena</b>, on his own army enrolment card. That card also does what no other document had
      managed: it <b>corroborates the passport from outside the family</b>, in Argentine hands, giving the
      same year and the same birthplace. <a href={u("/enrolment-card/")}>The card →</a></p>
    <p>What still stops is the baptism — and on <b>13 September 2026</b> the question changed shape.
      The Rosario index has been read <b>letter by letter, under any surname, for 1881, 1882 and
      1883</b>; the 1879–1901 volume end to end; and now the earlier volume too, <b>1731 to 1879, eighty
      openings</b>. Across <b>both volumes and a hundred and seventy years</b>, the surname Lerena
      appears <b>once</b>. Until 1888 the cathedral was the city&rsquo;s only parish. A boy born there in
      February 1882 to a father named Lerena ought to be in that book; so ought his brothers and sisters,
      and his father&rsquo;s marriage, and none of them is. <b>A household that lives in a parish leaves
      baptisms. This one leaves nothing.</b> <a href={u("/searched/")}>The sweep →</a></p>
    <p>And the one Lerena who <em>is</em> there points away from Argentina altogether. Folio 229,
      February 1866: the act names <b>Don Luis Lerena Lenguas</b> and <b>Doña Julia Juanicó</b> and says
      of both, <b><i>&ldquo;naturales del E. Oriental&rdquo;</i></b> — natives of Uruguay. The godfather,
      another Don Luis Lerena, stood <b>by proxy</b>, which is what one does from the other side of the
      river. Published Uruguayan genealogy makes that family the <b>Lerena Lenguas of Montevideo</b> — one
      of whose sons co-founded the <b>Argentine Stud Book</b>, and <b>Pablo Armando trained and owned
      racehorses</b>. Nothing yet links the two houses. But it says where to look next.
      <a href={u("/hypotheses/")}>Hypothesis 1c →</a></p>
    <p>And one thing the card does <em>not</em> settle, said plainly: <b>María is written with her
      husband&rsquo;s surname</b>. Whether she was a Lerena by birth — which would make the marriage one
      between kin — or was entered under her married name, the card cannot tell. Her maiden name is the
      next thing to find.</p>
  </div>
  <div class="note" style="margin-top:26px">Corrections are the most valuable thing anyone can send. A
    family member with a date, a photograph of a document, or a flat contradiction of something written
    here will change this archive, and the change will be recorded rather than quietly made.</div>
</section>

  
<section class="blk">
  <h2>The families who married in</h2>
  <p class="dek">Most people carrying this name have no proved relationship to the line. This is what has been decided about each.
  <a href={u("/marriages/")}>The marriages, in full →</a></p>
  <MarriageChart groups={chartGroups} subject="Lerena" unit="people carrying the name" />
</section>

<section class="blk">
    <h2>What this archive has established</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>They were not a Rosario family</h3>
        <p>Both volumes of the Rosario baptism index have been read end to end — <strong>1731 to
        1901</strong>. In a hundred and seventy years the surname appears <strong>once</strong>, and
        that act calls both parents <em>«naturales del E. Oriental»</em>: natives of Uruguay.
        <a href={u("/argentina/")}>What the registers say →</a></p>
      </div>
      <div class="card">
        <h3>His father has a name</h3>
        <p>The <strong>1908 ficha de enrolamiento</strong>, Cajón 985, names Pablo Armando's father
        and mother — <strong>Juan Carlos Lerena</strong> and María — and then stops. It is the one
        document holding the Argentine end of this line up.
        <a href={u("/enrolment-card/")}>The card →</a></p>
      </div>
      <div class="card">
        <h3>A birthplace, a birthday, a trade</h3>
        <p>Passport <strong>Série A No. 07962</strong>, issued at Cape Town on Christmas Eve 1940,
        settles three things in his own lifetime's paperwork, and gives his profession in one word:
        <strong>Trainer</strong>. <a href={u("/passport/")}>What it settles →</a></p>
      </div>
      <div class="card">
        <h3>The English side goes further than the Spanish</h3>
        <p>The Taylors reach <strong>James, born about 1796</strong> — four generations — while the
        Lerenas stop one generation above Pablo. The wall is not in the family; it is in what
        Argentina lets the public read. <a href={u("/taylor/")}>The Taylors →</a></p>
      </div>
    </div>
  </section>

<Numbers rows={stats.map(([n, l, h]) => [n, l, u(h)])} />

  <section class="blk" style="border-bottom:0">
    <h2>What is still missing</h2>
    <p class="dek">Published deliberately: <strong>an archive that lists only its answers is
    advertising; one that lists its questions can be helped by strangers.</strong> The enrolment card
    names Juan Carlos and María Lerena and nothing else is known of either — not a date, not a
    marriage, not a death. Argentine civil registration is not open, so the wall is administrative
    rather than evidential. <a href={u("/open-questions/")}>Open questions →</a></p>
    <p class="small" style="margin-top:1rem">Nothing here is taken on trust because it appears in a
    family tree. Where a record has been seen, it is cited; where it has not, the claim is marked.
    See <a href={u("/method/")}>Method</a>.</p>
  </section>
</Base>
