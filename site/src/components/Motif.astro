---
/* Small line motifs for section rules. Same role as the Defranceski archive's Motif:
   a quiet piece of house furniture that makes a long page readable. */
const { name = "arrows", size = 26 } = Astro.props;
const s = size;
---
{name === "arrows" && (
  <svg width={s} height={s/2} viewBox="0 0 26 13" fill="none" aria-hidden="true">
    <path d="M1 6.5h9M16 6.5h9" stroke="currentColor" stroke-width="1" opacity=".5"/>
    <path d="M11.5 3.5 14 6.5l-2.5 3M14.5 3.5 12 6.5l2.5 3" stroke="currentColor" stroke-width="1"/>
  </svg>
)}
{name === "horse" && (
  <svg width={s} height={s/2} viewBox="0 0 26 13" fill="none" aria-hidden="true">
    <path d="M1 6.5h7M18 6.5h7" stroke="currentColor" stroke-width="1" opacity=".5"/>
    <path d="M10 10c0-3 1-4 2-5 .6-.6 1-1.4 1-2 .8.5 1.4 1.2 1.8 2 .7.2 1.2.7 1.2 1.5 0 1.4-1.2 2-2 2.2-.6.2-1 .8-1 1.3"
          stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "star" && (
  <svg width={s} height={s/2} viewBox="0 0 26 13" fill="none" aria-hidden="true">
    <path d="M1 6.5h9M16 6.5h9" stroke="currentColor" stroke-width="1" opacity=".5"/>
    <path d="M13 3 14 5.8 16.8 6.5 14 7.2 13 10 12 7.2 9.2 6.5 12 5.8Z"
          stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
  </svg>
)}
